/* The page of feature definitions, written from src/features.json by the build target "features" */

/** \page definitions Feature definitions

\tableofcontents

Each feature's definition, the published sources it follows and its validation level. The first source is the origin, the work that introduced the feature; any other is a formulation, a later work whose form of the definition the library computes. A feature with no source is defined by the library, and its definition is the reference.

The validation level states how far the feature's results have been checked against values computed independently of the library, on the inputs the checks use and on every platform the library is tested on:

- 3, certified: by a machine-checked proof
- 2, derived: from the definition, or from certified published data
- 1, compared: with an independent implementation
- 0, not checked

\section definition_mean Mean

xtract_mean()

\f[ \bar{x} = \frac{1}{N} \sum_{n=0}^{N-1} x_n \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_variance Variance

xtract_variance()

\f[ s^2 = \frac{1}{N-1} \sum_{n=0}^{N-1} (x_n - m)^2, \quad m \text{ the mean given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_standard_deviation Standard Deviation

xtract_standard_deviation()

\f[ s = \sqrt{v}, \quad v \ge 0 \text{ the variance given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_average_deviation Average Deviation

xtract_average_deviation()

\f[ \frac{1}{N} \sum_{n=0}^{N-1} |x_n - m|, \quad m \text{ the mean given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_skewness Skewness

xtract_skewness()

\f[ \mathrm{Skew} = \frac{1}{N} \sum_{n=0}^{N-1} \left(\frac{x_n - m}{s}\right)^3, \quad m, s \text{ the mean and standard deviation given in argv}, \; s \ge 0; \text{ no result when } s = 0. \text{ It is } b_1 \text{ when } s \text{ divides by } N - 1, \text{ and } g_1 \text{ when } s \text{ divides by } N \f]

Sources:
- Origin: Pearson (1895). "Contributions to the mathematical theory of evolution. II. Skew variation in homogeneous material". Philosophical Transactions of the Royal Society of London, Series A 186, page 348, beta 1. <a href="https://doi.org/10.1098/rsta.1895.0010">doi:10.1098/rsta.1895.0010</a>
- Formulation: Joanes and Gill (1998). "Comparing measures of sample skewness and kurtosis". Journal of the Royal Statistical Society: Series D (The Statistician) 47(1), section 2, page 184, b1. <a href="https://doi.org/10.1111/1467-9884.00122">doi:10.1111/1467-9884.00122</a>

Validation level 3, certified.

\section definition_kurtosis Kurtosis

xtract_kurtosis()

\f[ \mathrm{Kurt} = \frac{1}{N} \sum_{n=0}^{N-1} \left(\frac{x_n - m}{s}\right)^4 - 3, \quad m, s \text{ the mean and standard deviation given in argv}, \; s \ge 0; \text{ no result when } s = 0. \text{ It is } b_2 \text{ when } s \text{ divides by } N - 1, \text{ and } g_2 \text{ when } s \text{ divides by } N \f]

Sources:
- Origin: Pearson (1905). "Das Fehlergesetz und seine Verallgemeinerungen durch Fechner und Pearson. A rejoinder". Biometrika 4(1-2), pages 173 and 174, beta 2. <a href="https://doi.org/10.1093/biomet/4.1-2.169">doi:10.1093/biomet/4.1-2.169</a>
- Formulation: Joanes and Gill (1998). "Comparing measures of sample skewness and kurtosis". Journal of the Royal Statistical Society: Series D (The Statistician) 47(1), section 2, page 185, b2. <a href="https://doi.org/10.1111/1467-9884.00122">doi:10.1111/1467-9884.00122</a>

Validation level 3, certified.

\section definition_spectral_mean Spectral Mean

xtract_spectral_mean()

\f[ \mu = \frac{\sum_{k=0}^{M-1} f_k a_k}{\sum_{k=0}^{M-1} a_k}, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.1

Validation level 3, certified.

\section definition_spectral_variance Spectral Variance

xtract_spectral_variance()

\f[ \sigma^2 = \frac{\sum_{k=0}^{M-1} (f_k - \mu)^2 a_k}{\sum_{k=0}^{M-1} a_k}, \quad \mu \text{ the spectral mean given in argv}, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.2

Validation level 3, certified.

\section definition_spectral_standard_deviation Spectral Standard Deviation

xtract_spectral_standard_deviation()

\f[ \sigma = \sqrt{v}, \quad v \ge 0 \text{ the spectral variance given in argv} \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.2

Validation level 3, certified.

\section definition_spectral_skewness Spectral Skewness

xtract_spectral_skewness()

\f[ \gamma_1 = \frac{\sum_{k=0}^{M-1} (f_k - \mu)^3 a_k}{\sigma^3 \sum_{k=0}^{M-1} a_k}, \quad \mu, \sigma \text{ the spectral mean and standard deviation given in argv}, \; \sigma \ge 0, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sigma = 0 \text{ or } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.3

Validation level 3, certified.

\section definition_spectral_kurtosis Spectral Kurtosis

xtract_spectral_kurtosis()

\f[ \gamma_2 - 3 = \frac{\sum_{k=0}^{M-1} (f_k - \mu)^4 a_k}{\sigma^4 \sum_{k=0}^{M-1} a_k} - 3, \quad \mu, \sigma \text{ the spectral mean and standard deviation given in argv}, \; \sigma \ge 0, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sigma = 0 \text{ or } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.4

Validation level 3, certified.

\section definition_spectral_centroid Spectral Centroid

xtract_spectral_centroid()

\f[ \mu = \frac{\sum_{k=0}^{M-1} f_k a_k}{\sum_{k=0}^{M-1} a_k}, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.1

Validation level 3, certified.

\section definition_irregularity_k Irregularity I

xtract_irregularity_k()

\f[ \mathrm{IRR} = \log_{10} S, \quad S = \sum_{n=1}^{N-2} \left| L_n - \frac{L_{n-1} + L_n + L_{n+1}}{3} \right| \text{ the smoothness given in argv} \f]

Sources:
- Origin: Krimphoff, McAdams and Winsberg (1994). "Caracterisation du timbre des sons complexes. II. Analyses acoustiques et quantification psychophysique". Journal de Physique IV 4(C5), equation 4. <a href="https://doi.org/10.1051/jp4:19945134">doi:10.1051/jp4:19945134</a>

Validation level 0, not checked.

\section definition_irregularity_j Irregularity II

xtract_irregularity_j()

\f[ \mathrm{IRR} = \frac{\sum_{n=0}^{N-1} (a_n - a_{n+1})^2}{\sum_{n=0}^{N-1} a_n^2}, \quad a_N = 0 \f]

Sources:
- Origin: Jensen (1999). "Timbre models of musical sounds". PhD thesis, University of Copenhagen, equation 7.16

Validation level 3, certified.

\section definition_tristimulus_1 Tristimulus I

xtract_tristimulus_1()

\f[ T_1 = \frac{a_1}{\sum_{h=1}^{N} a_h} \f]

Sources:
- Origin: Pollard and Jansson (1982). "A tristimulus method for the specification of musical timbre". Acustica 51(3), equations 4 to 6
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.6

Validation level 3, certified.

\section definition_tristimulus_2 Tristimulus II

xtract_tristimulus_2()

\f[ T_2 = \frac{\sum_{h=2}^{\min(4, N)} a_h}{\sum_{h=1}^{N} a_h} \f]

Sources:
- Origin: Pollard and Jansson (1982). "A tristimulus method for the specification of musical timbre". Acustica 51(3), equations 4 to 6
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.6

Validation level 3, certified.

\section definition_tristimulus_3 Tristimulus III

xtract_tristimulus_3()

\f[ T_3 = \frac{\sum_{h=5}^{N} a_h}{\sum_{h=1}^{N} a_h} \f]

Sources:
- Origin: Pollard and Jansson (1982). "A tristimulus method for the specification of musical timbre". Acustica 51(3), equations 4 to 6
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.6

Validation level 3, certified.

\section definition_smoothness Spectral Smoothness

xtract_smoothness()

\f[ S = \sum_{n=1}^{N-2} \left| L_n - \frac{L_{n-1} + L_n + L_{n+1}}{3} \right|, \quad L_n = \max\left(20 \log_{10} a_n, \; 20 \log_{10}(\epsilon \max_k a_k)\right), \quad \epsilon = 2^{-52} \f]

Sources:
- Origin: Krimphoff, McAdams and Winsberg (1994). "Caracterisation du timbre des sons complexes. II. Analyses acoustiques et quantification psychophysique". Journal de Physique IV 4(C5), equation 4. <a href="https://doi.org/10.1051/jp4:19945134">doi:10.1051/jp4:19945134</a>
- Formulation: McAdams (1999). "Perspectives on the contribution of timbre to musical structure". Computer Music Journal 23(3), equation 7. <a href="https://doi.org/10.1162/014892699559797">doi:10.1162/014892699559797</a>

Validation level 0, not checked.

\section definition_spread Spectral Spread

xtract_spread()

\f[ \sigma^2 = \frac{\sum_{k=0}^{M-1} (f_k - \mu)^2 a_k}{\sum_{k=0}^{M-1} a_k}, \quad \mu \text{ the spectral mean given in argv}, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k}; \text{ no result when } \sum_k a_k = 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.2

Validation level 3, certified.

\section definition_zcr Zero Crossing Rate

xtract_zcr()

\f[ \frac{1}{N} \left|\{k \ge 1 : \operatorname{sgn} x_{n_k} \ne \operatorname{sgn} x_{n_{k-1}}\}\right|, \quad n_0 < n_1 < \dots \text{ the indices of the } x_n \text{ that are neither 0 nor NaN} \f]

Sources:
- Origin: Gouyon, Pachet and Delerue (2000). "On the use of zero-crossing rate for an application of classification of percussive sounds". Proceedings of the COST G-6 Conference on Digital Audio Effects (DAFX-00), section 2.2.1. <a href="https://dafx.de/paper-archive/details/PMPmCG4vt7Eeuvn0803ULA">https://dafx.de/paper-archive/details/PMPmCG4vt7Eeuvn0803ULA</a>

Validation level 3, certified.

\section definition_rolloff Spectral Rolloff

xtract_rolloff()

\f[ f_r = \Delta f \, k^*, \quad k^* = \min\left\{k : \sum_{j=0}^{k} P_j \ge \frac{p}{100} \sum_{j=0}^{N-1} P_j\right\} \f]

Sources:
- Origin: Scheirer and Slaney (1997). "Construction and evaluation of a robust multifeature speech/music discriminator". Proceedings of ICASSP 1997, volume 2, section 2. <a href="https://doi.org/10.1109/ICASSP.1997.596192">doi:10.1109/ICASSP.1997.596192</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.7

Validation level 3, certified.

\section definition_loudness Loudness

xtract_loudness()

\f[ N' = \sum_{z : E_z > 0} E_z^{0.23} \f]

Sources:
- Origin: Moore, Glasberg and Baer (1997). "A model for the prediction of thresholds, loudness, and partial loudness". Journal of the Audio Engineering Society 45(4). <a href="https://www.aes.org/e-lib/browse.cfm?elib=10272">https://www.aes.org/e-lib/browse.cfm?elib=10272</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 8.1.1

Validation level 0, not checked.

\section definition_flatness Spectral Flatness

xtract_flatness()

\f[ \mathrm{SFM} = \frac{\left(\prod_{k=0}^{N-1} P_k\right)^{1/N}}{\frac{1}{N} \sum_{k=0}^{N-1} P_k}, \quad 0 \text{ when some } P_k \le 0 \f]

Sources:
- Origin: Gray and Markel (1974). "A spectral-flatness measure for studying the autocorrelation method of linear prediction of speech analysis". IEEE Transactions on Acoustics, Speech, and Signal Processing 22(3), equation 6. <a href="https://doi.org/10.1109/TASSP.1974.1162572">doi:10.1109/TASSP.1974.1162572</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 9.1

Validation level 0, not checked.

\section definition_flatness_db Log Spectral Flatness

xtract_flatness_db()

\f[ \mathrm{SFM}_{\mathrm{dB}} = 10 \log_{10} \mathrm{SFM}, \text{ with } \mathrm{SFM} = 0 \text{ taken as } 2 \times 10^{-42} \f]

Sources:
- Origin: Johnston (1988). "Transform coding of audio signals using perceptual noise criteria". IEEE Journal on Selected Areas in Communications 6(2), page 318. <a href="https://doi.org/10.1109/49.608">doi:10.1109/49.608</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 9.1

Validation level 0, not checked.

\section definition_tonality Tonality

xtract_tonality()

\f[ \alpha = \min\left(\frac{\mathrm{SFM}_{\mathrm{dB}}}{-60}, 1\right) \f]

Sources:
- Origin: Johnston (1988). "Transform coding of audio signals using perceptual noise criteria". IEEE Journal on Selected Areas in Communications 6(2), page 318. <a href="https://doi.org/10.1109/49.608">doi:10.1109/49.608</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 9.1

Validation level 0, not checked.

\section definition_crest Spectral Crest Measure

xtract_crest()

\f[ C = \frac{\max_k x_k}{\frac{1}{N} \sum_{k=0}^{N-1} x_k} \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 9.1

Validation level 3, certified.

\section definition_noisiness Noisiness

xtract_noisiness()

\f[ \frac{\sum_{k \notin H} P_k}{\sum_k P_k} \text{ over the peaks with } f_k \ne 0, \quad H = \text{for each } h \ge 1 \text{, the largest peak } k \text{ with } \mathrm{round}(f_k / f_0) = h \text{ and } |f_k / f_0 - h| \le t \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.2

Validation level 0, not checked.

\section definition_rms_amplitude RMS Amplitude

xtract_rms_amplitude()

\f[ \sqrt{\frac{1}{N} \sum_{n=0}^{N-1} x_n^2} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_spectral_inharmonicity Inharmonicity

xtract_spectral_inharmonicity()

\f[ \frac{2}{f_0} \frac{\sum_k |f_k - h_k f_0| \, a_k^2}{\sum_k a_k^2}, \quad h_k = \mathrm{round}(f_k / f_0), \text{ over the peaks with } a_k \ne 0 \text{ and } h_k \ne 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.3

Validation level 0, not checked.

\section definition_odd_even_ratio Odd/even Harmonic Ratio

xtract_odd_even_ratio()

\f[ \frac{\sum_{h \text{ odd}} E_h}{\sum_{h \text{ even}} E_h}, \quad h = 1, \dots, N \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 7.1.5

Validation level 3, certified.

\section definition_sharpness Spectral Sharpness

xtract_sharpness()

\f[ S = 0.11 \frac{\sum_{z=1}^{N} z \, g(z) \, E_z^{0.23}}{\sum_{z=1}^{N} E_z^{0.23}}, \quad g(z) = \begin{cases} 1 & z < 15 \\ 0.066 \, e^{0.171 z} & z \ge 15 \end{cases} \f]

Sources:
- Origin: von Bismarck (1974). "Sharpness as an attribute of the timbre of steady sounds". Acustica 30(3), equation 1
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 8.1.3

Validation level 0, not checked.

\section definition_spectral_slope Spectral Slope

xtract_spectral_slope()

\f[ \frac{1}{\sum_k a_k} \frac{\sum_k (f_k - \bar{f})(a_k - \bar{a})}{\sum_k (f_k - \bar{f})^2}, \text{ over } k = 0 \text{ and the } k \text{ with } f_k \ne 0 \text{ or } a_k \ne 0 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 6.1.5

Validation level 0, not checked.

\section definition_lowest_value Lowest Value

xtract_lowest_value()

\f[ \min \{x_n : x_n > t\}, \quad t \text{ the threshold given in argv}, \text{ a NaN never above it}; \text{ no result when no } x_n > t \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_highest_value Highest Value

xtract_highest_value()

\f[ \max_{0 \le n < N} x_n \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_sum Sum of Values

xtract_sum()

\f[ \sum_{n=0}^{N-1} x_n \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_nonzero_count Non-zero count

xtract_nonzero_count()

\f[ \left|\{n : x_n \ne 0\}\right|, \quad \text{a NaN counts} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_hps Harmonic Product Spectrum

xtract_hps()

\f[ f = q\,(k^* + \delta), \quad \hat k = \arg\max_{1 \le k \le \lfloor (M-1)/R \rfloor} \sum_{r=1}^{R} \ln\max(a_{rk}, \epsilon\,a_{\max}) \text{ (the first on a tie)}, \quad k^* = j \text{ if } 0.4\hat k < j < 0.6\hat k \text{ and } a_j > 0.1\,a_{\hat k}, \text{ else } \hat k, \quad j \text{ the largest peak below } \hat k \text{ (the first of equal peaks)}, \text{ a peak being the last bin of a run of equal } a_k \text{ above the bins either side of the run}, \quad \delta \text{ the vertex offset of the parabola through } L_{k^*-1}, L_{k^*}, L_{k^*+1} \text{ limited to } \pm\tfrac{1}{2}, \text{ or } 0 \text{ when } k^* \text{ is bin 1 or } M-1, \text{ when } a_{k^*} \text{ is below either neighbour, or when the parabola's denominator is } 0, \quad L_k = \ln\max(a_k, \epsilon\,a_{\max}), \quad a_k = x_k, \; M = N/2, \; a_{\max} = \max(0, \max_k a_k), \quad q \text{ the bin spacing}, \; R \text{ the harmonics given in argv}, \; \epsilon = 2^{-52}; \text{ no result when } a_{\max} = 0, \; \lfloor (M-1)/R \rfloor < 2 \text{ or } a_{\hat k} \le 0 \f]

Sources:
- Origin: Schroeder (1968). "Period histogram and product spectrum: new methods for fundamental-frequency measurement". Journal of the Acoustical Society of America 43(4), equation 1. <a href="https://doi.org/10.1121/1.1910902">doi:10.1121/1.1910902</a>
- Formulation: de la Cuadra, Master and Sapp (2001). "Efficient pitch detection techniques for interactive music". Proceedings of the International Computer Music Conference 2001, section 2.1, equations 1 and 2 and the octave rule

Validation level 0, not checked.

\section definition_f0 Fundamental Frequency

xtract_f0()

\f[ f_0 = \frac{f_s}{\tau + D(\tau)/D(1)}, \quad \tau = \min\{k : 2 \le k \le M-1,\ D(k) < D(1)\}, \quad D(k) = \sum_{n=0}^{M-1} |z_n - z_{n+k}|, \quad M = \lfloor N/2 \rfloor, \quad z_n = \operatorname{sgn}(y_n)\max(|y_n| - 0.3c, 0), \quad y_n = \min(\max(x_n, -0.8c), 0.8c), \quad c = \max_n |x_n|, \quad f_s \text{ the sample rate given in argv}; \text{ no result when no such } \tau \text{ exists} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_failsafe_f0 Fundamental Frequency (failsafe)

xtract_failsafe_f0()

\f[ f = f_0 \text{ of xtract\_f0 when it has a result; otherwise } f = \min_{k \in K} \frac{f_s}{N}\left(k + \frac{1}{2}\,\frac{a_{k-1} - a_{k+1}}{a_{k-1} - 2a_k + a_{k+1}}\right), \quad K = \{k : 1 \le k \le N/2 - 2,\ a_k > a_{k-1},\ a_k > a_{k+1},\ a_k \ge 0.1\max_{j \ge 1} a_j\}, \quad a_k \text{ the magnitude of bin } k; \text{ no result when } K \text{ is empty} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_wavelet_f0 Fundamental Frequency (wavelet method)

xtract_wavelet_f0()

\f[ f_0 = \frac{f_s}{2^{l-1} \bar{d}_{l-1}}, \quad l = \text{the first level from 2 at which } |\bar{d}_{l-1} - 2 \bar{d}_l| \le \delta_l, \quad a_l(n) = \frac{a_{l-1}(2n) + a_{l-1}(2n+1)}{2}, \; a_0 = x, \quad \delta_l = \max\left(\left\lfloor \frac{f_s}{3000 \cdot 2^l} \right\rfloor, 1\right), \quad \bar{d}_l = \text{the mean of the distances between extrema of } a_l \text{ within } \delta_l \text{ of their mode}, \; l = 1, \dots, 5 \f]

Sources:
- Origin: Larson and Maddox (2005). "Real-time time-domain pitch tracking using wavelets". Report, NSF Research Experiences for Undergraduates, Department of Physics, University of Illinois at Urbana-Champaign, section II, equations 2 and 3, table I and appendix A

Validation level 0, not checked.

\section definition_mcleod_f0 Fundamental Frequency (McLeod Pitch Method)

xtract_mcleod_f0()

\f[ f_0 = \frac{f_s}{\tau^* + \delta}, \quad \delta = \frac{n_{\tau^*-1} - n_{\tau^*+1}}{2 (n_{\tau^*-1} - 2 n_{\tau^*} + n_{\tau^*+1})}, \quad \tau^* = \text{the first key maximum with } h(\tau^*) \ge 0.8 \max_{\text{key}} h, \quad h(\tau) = \min\left(n_\tau - \frac{(n_{\tau-1} - n_{\tau+1})^2}{8 (n_{\tau-1} - 2 n_\tau + n_{\tau+1})}, 1\right), \quad n_\tau = \frac{2 \sum_{j=0}^{N-1-\tau} x_j x_{j+\tau}}{\sum_{j=0}^{N-1-\tau} (x_j^2 + x_{j+\tau}^2)}, \quad \text{key maxima taken over } 1 \le \tau \le \min(\lfloor N/2 \rfloor, N-2) \f]

Sources:
- Origin: McLeod and Wyvill (2005). "A smarter way to find pitch". Proceedings of the International Computer Music Conference, Barcelona, sections 5 and 6

Validation level 0, not checked.

\section definition_midicent Frequency to MIDI Cent conversion

xtract_midicent()

\f[ m = \mathrm{round}\left(6900 + 1200 \log_2 \frac{f}{440}\right), \text{ halves away from 0}, \quad f \text{ the frequency given in argv}; \text{ no result when } f = 0 \text{ or } m \notin [0, 12700] \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_lnorm L-norm

xtract_lnorm()

\f[ \|x\|_p = \left(\sum_{k \in K} |x_k|^p\right)^{1/p}, \quad K = \text{every } k \text{, the } k \text{ with } x_k > 0 \text{, or the } k \text{ with } x_k < 0 \text{, as the filter selects}, \quad p = \text{the order given when it is above 0, else } 2 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_flux Spectral Flux

xtract_flux()

\f[ \left(\sum_{k \in K} |X_n(k) - X_{n-1}(k)|^p\right)^{1/p}, \quad K = \text{every } k \text{, the rising } k \text{, or the falling } k \text{, as the filter selects}, \quad p = \text{the order given when it is above 0, else } 2 \f]

Sources:
- Origin: Scheirer and Slaney (1997). "Construction and evaluation of a robust multifeature speech/music discriminator". Proceedings of ICASSP 1997, volume 2, section 2, spectral flux. <a href="https://doi.org/10.1109/ICASSP.1997.596192">doi:10.1109/ICASSP.1997.596192</a>
- Formulation: Boeck, Krebs and Schedl (2012). "Evaluating the online capabilities of onset detection methods". Proceedings of the 13th International Society for Music Information Retrieval Conference, equation 3. <a href="https://doi.org/10.5281/zenodo.1416036">doi:10.5281/zenodo.1416036</a>

Validation level 0, not checked.

\section definition_attack_time Attack Time

xtract_attack_time()

\f[ T_a = \frac{n_2 - n_1}{f_s}, \quad n_1 = \min\{n : x_n \ge s\,x_{\max}\}, \quad n_2 = \min\{n \ge n_1 : x_n \ge e\,x_{\max}\}, \quad x_{\max} = \max_n x_n, \quad f_s, s, e \text{ the sample rate and fractions given in argv}; \text{ no result when } x_{\max} \le 0 \f]

Sources:
- Origin: Krimphoff, McAdams and Winsberg (1994). "Caracterisation du timbre des sons complexes. II. Analyses acoustiques et quantification psychophysique". Journal de Physique IV 4(C5), section 3.2, equation 3. <a href="https://doi.org/10.1051/jp4:19945134">doi:10.1051/jp4:19945134</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 3.1.2.1

Validation level 0, not checked.

\section definition_decay_time Decay Time

xtract_decay_time()

\f[ T_d = \frac{m - p}{f_s}, \quad p = \min\{n : x_n = x_{\max}\}, \quad m = \min\left(\{n \ge p : x_n \le c\,x_{\max}\} \cup \{N-1\}\right), \quad f_s, c \text{ the sample rate and fraction given in argv}; \text{ no result when } x_{\max} \le 0 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_difference_vector Difference vector

xtract_difference_vector()

\f[ r_n = x_n - x_{N/2+n}, \quad n = 0, \ldots, N/2 - 1 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_autocorrelation Autocorrelation

xtract_autocorrelation()

\f[ r_\tau = \frac{1}{N} \sum_{n=0}^{N-1-\tau} x_n x_{n+\tau}, \quad \tau = 0, \ldots, N-1 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_amdf Average Magnitude Difference Function

xtract_amdf()

\f[ D_\tau = \frac{1}{N} \sum_{n=0}^{N-1-\tau} |x_n - x_{n+\tau}|, \quad \tau = 0, \ldots, N-1 \f]

Sources:
- Origin: Ross, Shaffer, Cohen, Freudberg and Manley (1974). "Average magnitude difference function pitch extractor". IEEE Transactions on Acoustics, Speech, and Signal Processing 22(5), equation 5. <a href="https://doi.org/10.1109/TASSP.1974.1162598">doi:10.1109/TASSP.1974.1162598</a>

Validation level 0, not checked.

\section definition_asdf Average Squared Difference Function

xtract_asdf()

\f[ S_\tau = \frac{1}{N} \sum_{n=0}^{N-1-\tau} (x_n - x_{n+\tau})^2, \quad \tau = 0, \ldots, N-1 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_bark_coefficients Bark Coefficients

xtract_bark_coefficients()

\f[ B_b = \sum_{k=l_b}^{\min(l_{b+1}, N)-1} x_k, \; b = 0, \dots, 24, \quad B_{25} = \sum_{k=l_{25}}^{N-1} x_k, \quad l_b \text{ the band limits given in argv}, \text{ an empty sum } 0 \f]

Sources:
- Origin: Zwicker (1961). "Subdivision of the audible frequency range into critical bands (Frequenzgruppen)". Journal of the Acoustical Society of America 33(2), table I. <a href="https://doi.org/10.1121/1.1908630">doi:10.1121/1.1908630</a>
- Formulation: Smith and Abel (1999). "Bark and ERB bilinear transforms". IEEE Transactions on Speech and Audio Processing 7(6), section 3, the table of band edges. <a href="https://doi.org/10.1109/89.799695">doi:10.1109/89.799695</a>

Validation level 0, not checked.

\section definition_peak_spectrum Peak Spectrum

xtract_peak_spectrum()

\f[ T = \frac{t}{100} \max(0, \max_{1 \le n < N} a_n); \text{ for } 1 \le n \le N-2 \text{ with } a_n \ge T, \; a_n > a_{n-1}, \; a_n > a_{n+1}: \; p = \frac{1}{2} \frac{a_{n-1} - a_{n+1}}{a_{n-1} - 2 a_n + a_{n+1}}, \; r_n = a_n - \frac{1}{4}(a_{n-1} - a_{n+1}) p, \; r_{N+n} = \Delta f (n + p); \text{ every other } r_n = r_{N+n} = 0, \quad \Delta f, t \text{ the bin spacing and threshold given in argv} \f]

Sources:
- Origin: Smith and Serra (1987). "PARSHL: an analysis/synthesis program for non-harmonic sounds based on a sinusoidal representation". Technical report STAN-M-43, CCRMA, Stanford University, section 5, equations 12 to 14. <a href="https://ccrma.stanford.edu/files/papers/stanm43.pdf">https://ccrma.stanford.edu/files/papers/stanm43.pdf</a>

Validation level 0, not checked.

\section definition_spectrum Spectrum

xtract_spectrum()

\f[ X_m = \frac{1}{N} \sum_{n=0}^{N-1} x_n e^{-2 \pi i m n / N}, \quad r_m = \operatorname{Re} X_m, \; r_{N/2+m} = \operatorname{Im} X_m, \quad m = 0, \ldots, \frac{N}{2} - 1, \quad \operatorname{Im} X_0 = 0 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_autocorrelation_fft Autocorrelation (FFT method)

xtract_autocorrelation_fft()

\f[ r_\tau = \frac{1}{N} \sum_{n=0}^{N-1-\tau} x_n x_{n+\tau}, \quad \tau = 0, \ldots, N-1 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_mfcc Mel-Frequency Cepstral Coefficients

xtract_mfcc()

\f[ c_i = \sum_{m=1}^{M} \ln \max\left(E_m, \epsilon \max_j E_j\right) \cos\left(\frac{\pi i (m - \tfrac{1}{2})}{M}\right) \text{ when } \max_j E_j > 0, \text{ and } c_i = 0 \text{ otherwise}, \quad i = 0, \dots, M-1, \quad E_m = \sum_k H_m(k) P_k, \quad \epsilon = 2^{-52} \f]

Sources:
- Origin: Davis and Mermelstein (1980). "Comparison of parametric representations for monosyllabic word recognition in continuously spoken sentences". IEEE Transactions on Acoustics, Speech, and Signal Processing 28(4), equation 1 and figure 1. <a href="https://doi.org/10.1109/TASSP.1980.1163420">doi:10.1109/TASSP.1980.1163420</a>
- Formulation: Rabiner and Juang (1993). "Fundamentals of speech recognition". PTR Prentice Hall, section 4.5.6, equation 4.90
- Formulation: Young, Evermann, Gales, Hain, Kershaw, Liu, Moore, Odell, Ollason, Povey, Valtchev and Woodland (2009). "The HTK book, for HTK version 3.4". Cambridge University Engineering Department, section 5.4, equation 5.13

Validation level 0, not checked.

\section definition_dct Discrete Cosine Transform

xtract_dct()

\f[ X_k = \sum_{n=0}^{N-1} x_n \cos\left(\frac{\pi k (2n+1)}{2N}\right), \quad k = 0, \ldots, N-1 \f]

Sources:
- Origin: Ahmed, Natarajan and Rao (1974). "Discrete cosine transform". IEEE Transactions on Computers C-23(1), equation 1, without its scale factors. <a href="https://doi.org/10.1109/T-C.1974.223784">doi:10.1109/T-C.1974.223784</a>

Validation level 0, not checked.

\section definition_harmonic_spectrum Harmonic Spectrum

xtract_harmonic_spectrum()

\f[ h_n = \operatorname{round}(f_n / f_0); \text{ harmonic } h \text{ takes the largest vertex amplitude among the local maxima } n \text{ with } h_n = h \text{ and } |h_n - f_n/f_0| \le t, \text{ else the element with } h_n = h \text{ nearest to } h f_0 \text{ (the lower on a tie)}; \; r_n = \hat a_n \text{ (DBL\_MIN if 0)}, \; r_{M+n} = \hat f_n, \text{ every other element 0}, \quad f_0, t \text{ the fundamental and threshold given in argv}; \text{ no result when } f_0 = 0, \text{ when a harmonic below the highest has no element nearest to it, or when no harmonic lies among the elements} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_lpc Linear predictive coding coefficients

xtract_lpc()

\f[ E_0 = r_0, \quad k_i = -\frac{r_i + \sum_{j=1}^{i-1} a_j^{(i-1)} r_{i-j}}{E_{i-1}}, \quad a_i^{(i)} = k_i, \quad a_j^{(i)} = a_j^{(i-1)} + k_i a_{i-j}^{(i-1)}, \quad E_i = (1 - k_i^2) E_{i-1}, \quad i = 1, \dots, p, \quad A(z) = 1 + \sum_{j=1}^{p} a_j^{(p)} z^{-j} \f]

Sources:
- Origin: Atal and Hanauer (1971). "Speech analysis and synthesis by linear prediction of the speech wave". Journal of the Acoustical Society of America 50(2B), appendix E, equations E8 to E10, with the opposite sign. <a href="https://doi.org/10.1121/1.1912679">doi:10.1121/1.1912679</a>
- Formulation: Makhoul (1975). "Linear prediction: a tutorial review". Proceedings of the IEEE 63(4), equations 12 and 38a to 38e. <a href="https://doi.org/10.1109/PROC.1975.9792">doi:10.1109/PROC.1975.9792</a>

Validation level 0, not checked.

\section definition_lpcc Linear predictive coding cepstral coefficients

xtract_lpcc()

\f[ c_n = -a_n - \frac{1}{n} \sum_{k=\max(1, n-p)}^{n-1} k \, c_k \, a_{n-k}, \quad n = 1, \dots, Q, \quad a_n = 0 \text{ for } n > p \f]

Sources:
- Origin: Atal (1974). "Effectiveness of linear prediction characteristics of the speech wave for automatic speaker identification and verification". Journal of the Acoustical Society of America 55(6), equation 15, in the opposite sign. <a href="https://doi.org/10.1121/1.1914702">doi:10.1121/1.1914702</a>
- Formulation: Rabiner and Juang (1993). "Fundamentals of speech recognition". PTR Prentice Hall, equation 4.19, p. 163, and equation 3.83c, p. 115

Validation level 0, not checked.

\section definition_subbands Sub band coefficients

xtract_subbands()

\f[ R_b = g\left(x_{u_b}, \dots, x_{u_b + w_b - 1}\right) \text{ when } u_b + w_b \le N, \text{ and } R_b = 0 \text{ otherwise}, \quad b = 0, \dots, B-1, \quad \text{linear: } w_b = \lfloor (N - s)/B \rfloor, \; u_b = s + b w_b, \quad \text{octave: } u_b = w_b = 2^b s, \quad g, B, s \text{ the feature, band count and start given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_mel_spectrogram Mel Spectrogram

xtract_mel_spectrogram()

\f[ L_m = \ln \max\left(E_m, \epsilon \max_j E_j\right), \quad E_m = \sum_{k=0}^{N-1} H_m(k) P_k, \quad \epsilon = 2^{-52}, \quad H_m \text{ the gains of filter } m; \text{ no result when } \max_j E_j \le 0 \f]

Sources:
- Origin: Davis and Mermelstein (1980). "Comparison of parametric representations for monosyllabic word recognition in continuously spoken sentences". IEEE Transactions on Acoustics, Speech, and Signal Processing 28(4), equation 1 and figure 1. <a href="https://doi.org/10.1109/TASSP.1980.1163420">doi:10.1109/TASSP.1980.1163420</a>
- Formulation: Rabiner and Juang (1993). "Fundamentals of speech recognition". PTR Prentice Hall, section 4.5.6, equation 4.90
- Formulation: Young, Evermann, Gales, Hain, Kershaw, Liu, Moore, Odell, Ollason, Povey, Valtchev and Woodland (2009). "The HTK book, for HTK version 3.4". Cambridge University Engineering Department, section 5.4, equation 5.13

Validation level 0, not checked.

\section definition_gfcc Gammatone Frequency Cepstral Coefficients

xtract_gfcc()

\f[ c_i = \sum_{m=1}^{F} L_m \cos\left(\frac{\pi i (m - \tfrac{1}{2})}{F}\right), \quad i = 0, \dots, F-1, \quad L_m \text{ the log energies of xtract\_gammatone\_spectrogram}; \text{ no result when it has none} \f]

Sources:
- Origin: Valero and Alias (2012). "Gammatone cepstral coefficients: biologically inspired features for non-speech audio classification". IEEE Transactions on Multimedia 14(6), equations 3 to 5. <a href="https://doi.org/10.1109/TMM.2012.2199972">doi:10.1109/TMM.2012.2199972</a>

Validation level 0, not checked.

\section definition_gammatone_spectrogram Gammatone Spectrogram

xtract_gammatone_spectrogram()

\f[ L_m = \ln \max\left(E_m, \epsilon \max_j E_j\right), \quad E_m = \sum_{k=0}^{N-1} H_m(k) P_k, \quad H_m(k) = \left(1 + \left(\frac{k f_s / T - c_m}{1.019 \, B(c_m)}\right)^2\right)^{-4}, \quad B(f) = 24.7\left(\frac{4.37 f}{1000} + 1\right), \quad T = 2N, \; f_s \text{ the sample rate given to xtract\_init\_gfcc}, \quad c_m \text{ equally spaced on } \ln\left(1 + \frac{4.37 f}{1000}\right) \text{ from } f_{\min} \text{ to } f_{\max}, \quad \epsilon = 2^{-52}; \text{ no result when } \max_j E_j \le 0 \f]

Sources:
- Origin: Patterson, Robinson, Holdsworth, McKeown, Zhang and Allerhand (1992). "Complex sounds and auditory images". Auditory Physiology and Perception, Proceedings of the 9th International Symposium on Hearing, Pergamon, equations 1 and 2. <a href="https://doi.org/10.1016/B978-0-08-041847-6.50054-X">doi:10.1016/B978-0-08-041847-6.50054-X</a>
- Formulation: Glasberg and Moore (1990). "Derivation of auditory filter shapes from notched-noise data". Hearing Research 47(1-2), equations 3 and 4. <a href="https://doi.org/10.1016/0378-5955(90)90170-T">doi:10.1016/0378-5955(90)90170-T</a>

Validation level 0, not checked.

\section definition_windowed Windowed frame

xtract_windowed()

\f[ y_n = x_n w_n, \quad n = 0, \ldots, N-1, \quad w \text{ the window given in argv; with } M = N-1, \text{ Hann } \tfrac{1}{2}(1 - \cos\tfrac{2\pi n}{M}), \text{ Hamming } 0.54 - 0.46\cos\tfrac{2\pi n}{M}, \text{ Blackman } 0.42 - 0.5\cos\tfrac{2\pi n}{M} + 0.08\cos\tfrac{4\pi n}{M}, \text{ Blackman-Harris } 0.35875 - 0.48829\cos\tfrac{2\pi n}{M} + 0.14128\cos\tfrac{4\pi n}{M} - 0.01168\cos\tfrac{6\pi n}{M}, \text{ Bartlett } 1 - \left|\tfrac{2n}{M} - 1\right|, \text{ triangular } \tfrac{2}{N}\left(\tfrac{N}{2} - \left|n - \tfrac{M}{2}\right|\right), \text{ Bartlett-Hann } 0.62 - 0.48\left|\tfrac{n}{M} - \tfrac{1}{2}\right| - 0.38\cos\tfrac{2\pi n}{M}, \text{ Gauss } \exp\left(-\tfrac{1}{2}\left(\tfrac{n - M/2}{0.4 M/2}\right)^2\right), \text{ Kaiser } \frac{I_0\left(3\pi\sqrt{1 - (2n/M - 1)^2}\right)}{I_0(3\pi)} \f]

Sources:
- Origin: Harris (1978). "On the use of windows for harmonic analysis with the discrete Fourier transform". Proceedings of the IEEE 66(1), equations 23a, 28a, 30b, 32, 33, 44a and 46a, and table I. <a href="https://doi.org/10.1109/PROC.1978.10837">doi:10.1109/PROC.1978.10837</a>
- Formulation: Ha and Pearce (1989). "A new window and comparison to standard windows". IEEE Transactions on Acoustics, Speech, and Signal Processing 37(2), equation 6, the Bartlett-Hann window. <a href="https://doi.org/10.1109/29.21693">doi:10.1109/29.21693</a>

Validation level 0, not checked.

\section definition_smoothed Smoothed frame

xtract_smoothed()

\f[ u_{N-1} = x_{N-1}, \quad u_n = g x_n + (1-g) x_{n+1} \; (0 \le n \le N-2), \quad y_0 = u_0, \quad y_n = g u_n + (1-g) y_{n-1} \; (1 \le n \le N-1), \quad 0 \le g \le 1 \text{ the gain given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_peak Peak

xtract_peak()

\f[ y = x_{N-1} \text{ if } x_{N-1} = \max_{0 \le n < N} x_n \text{ and } x_{N-1} \ge \frac{1}{N} \sum_{n=0}^{N-1} x_n + \delta, \quad \delta \text{ the threshold given in argv}; \text{ otherwise no result} \f]

Sources:
- Origin: Dixon (2006). "Onset detection revisited". Proceedings of the 9th International Conference on Digital Audio Effects (DAFx-06), section 2.6, the first two conditions. <a href="https://www.dafx.de/paper-archive/2006/papers/p_133.pdf">https://www.dafx.de/paper-archive/2006/papers/p\_133.pdf</a>
- Formulation: Boeck, Krebs and Schedl (2012). "Evaluating the online capabilities of onset detection methods". Proceedings of the 13th International Society for Music Information Retrieval Conference, section 2.3.4, conditions 1 and 2 with w2 = w4 = 0. <a href="https://doi.org/10.5281/zenodo.1416036">doi:10.5281/zenodo.1416036</a>

Validation level 0, not checked.

\section definition_mmbses Mel Multi-Band Spectral Entropy Signature

xtract_mmbses()

\f[ H_b = \ln(2 \pi e) + \tfrac{1}{2} \ln \max\left(D_b, \; \epsilon \max_{c : K_c \ne \emptyset} D_c\right), \quad D_b = s_{xx,b} s_{yy,b} - s_{xy,b}^2, \quad s_{xx,b} = \frac{1}{|K_b|} \sum_{k \in K_b} (w_{bk} \operatorname{Re} X_k)^2, \; s_{yy,b} = \frac{1}{|K_b|} \sum_{k \in K_b} (w_{bk} \operatorname{Im} X_k)^2, \; s_{xy,b} = \frac{1}{|K_b|} \sum_{k \in K_b} w_{bk}^2 \operatorname{Re} X_k \operatorname{Im} X_k, \quad K_b = \{k : w_{bk} \ne 0\}, \quad \epsilon = 2^{-52}, \quad H_b = 0 \text{ when } K_b \text{ is empty}, \quad \text{and every } H_b = 0 \text{ when no } D_c > 0 \f]

Sources:
- Origin: Camarena-Ibarrola and Chavez (2006). "On musical performances identification, entropy and string matching". MICAI 2006: Advances in Artificial Intelligence, Lecture Notes in Computer Science, section 1.1, equation 2. <a href="https://doi.org/10.1007/11925231_91">doi:10.1007/11925231\_91</a>
- Formulation: Rincon, Beltran, Tentori, Favela and Chavez (2013). "A context-aware baby monitor for the automatic selective archiving of the language of infants". Mexican International Conference on Computer Science (ENC 2013), section V.C, equation 5. <a href="https://doi.org/10.1109/ENC.2013.15">doi:10.1109/ENC.2013.15</a>

Validation level 0, not checked.

\section definition_spectral_subband_centroids Spectral Subband Centroids

xtract_spectral_subband_centroids()

\f[ C_m = \frac{\sum_{k=0}^{M-1} f_k H_m(k) a_k}{\sum_{k=0}^{M-1} H_m(k) a_k}, \text{ or } 0 \text{ when the denominator is } 0, \quad m = 1, \dots, F, \quad H_m \text{ the gains of filter } m, \quad M = N/2, \; a_k = x_k, \; f_k = x_{M+k} \f]

Sources:
- Origin: Paliwal (1997). "Spectral subband centroids as features for speech recognition". Proceedings of the IEEE Workshop on Automatic Speech Recognition and Understanding, equation 1. <a href="https://doi.org/10.1109/ASRU.1997.658996">doi:10.1109/ASRU.1997.658996</a>

Validation level 0, not checked.

\section definition_moving_sum Moving Sum

xtract_moving_sum()

\f[ y_m = \sum_{n=m}^{m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 1 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_moving_average Moving Average

xtract_moving_average()

\f[ y_m = \frac{1}{w} \sum_{n=m}^{m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 1 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_moving_variance Moving Variance

xtract_moving_variance()

\f[ y_m = \frac{1}{w-1} \sum_{n=m}^{m+w-1} (x_n - \bar{x}_m)^2, \quad \bar{x}_m = \frac{1}{w} \sum_{n=m}^{m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 2 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_moving_standard_deviation Moving Standard Deviation

xtract_moving_standard_deviation()

\f[ y_m = \sqrt{\frac{1}{w-1} \sum_{n=m}^{m+w-1} (x_n - \bar{x}_m)^2}, \quad \bar{x}_m = \frac{1}{w} \sum_{n=m}^{m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 2 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_moving_max Moving Maximum

xtract_moving_max()

\f[ y_m = \max_{m \le n \le m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 1 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_moving_min Moving Minimum

xtract_moving_min()

\f[ y_m = \min_{m \le n \le m+w-1} x_n, \quad m = 0, \ldots, N-w, \quad 1 \le w \le N \text{ the window given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_ewma_average Exponentially Weighted Moving Average

xtract_ewma_average()

\f[ y_0 = x_0, \quad y_n = y_{n-1} + \alpha (x_n - y_{n-1}), \quad n = 1, \ldots, N-1, \quad 0 \le \alpha \le 1 \text{ the factor given in argv} \f]

Sources:
- Origin: Roberts (1959). "Control chart tests based on geometric moving averages". Technometrics 1(3), equation 1, page 240. <a href="https://doi.org/10.1080/00401706.1959.10489860">doi:10.1080/00401706.1959.10489860</a>
- Formulation: Finch (2009). "Incremental calculation of weighted mean and variance". Technical note, University of Cambridge Computing Service, section 9, equations 122 and 128. <a href="https://fanf2.user.srcf.net/hermes/doc/antiforgery/stats.pdf">https://fanf2.user.srcf.net/hermes/doc/antiforgery/stats.pdf</a>

Validation level 0, not checked.

\section definition_ewma_variance Exponentially Weighted Moving Variance

xtract_ewma_variance()

\f[ \mu_0 = x_0, \; s_0 = 0, \quad \mu_n = \mu_{n-1} + \alpha (x_n - \mu_{n-1}), \quad s_n = (1-\alpha)\left(s_{n-1} + \alpha (x_n - \mu_{n-1})^2\right), \quad n = 1, \ldots, N-1, \quad 0 \le \alpha \le 1 \text{ the factor given in argv} \f]

Sources:
- Origin: Finch (2009). "Incremental calculation of weighted mean and variance". Technical note, University of Cambridge Computing Service, section 9, equation 143. <a href="https://fanf2.user.srcf.net/hermes/doc/antiforgery/stats.pdf">https://fanf2.user.srcf.net/hermes/doc/antiforgery/stats.pdf</a>

Validation level 0, not checked.

\section definition_median Median

xtract_median()

\f[ \mathrm{med}(x) = x_{((N+1)/2)} \text{ for odd } N, \quad \frac{1}{2}\left(x_{(N/2)} + x_{(N/2+1)}\right) \text{ for even } N, \quad x_{(k)} \text{ the } k\text{th smallest value, a NaN ordered after every number} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_median_absolute_deviation Median Absolute Deviation

xtract_median_absolute_deviation()

\f[ \mathrm{MAD} = \mathrm{med}_n |x_n - c|, \quad c \text{ the median given in argv}, \quad \mathrm{med} \text{ the median of xtract\_median, without a scale factor} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_hjorth_activity Hjorth Activity

xtract_hjorth_activity()

\f[ A = \frac{1}{N} \sum_{n=0}^{N-1} (x_n - \bar{x})^2 \f]

Sources:
- Origin: Hjorth (1970). "EEG analysis based on time domain properties". Electroencephalography and Clinical Neurophysiology 29(3), table I. <a href="https://doi.org/10.1016/0013-4694(70)90143-4">doi:10.1016/0013-4694(70)90143-4</a>

Validation level 0, not checked.

\section definition_hjorth_mobility Hjorth Mobility

xtract_hjorth_mobility()

\f[ M = \sqrt{\frac{\operatorname{var}(\Delta x)}{\operatorname{var}(x)}}, \quad \Delta x_n = x_{n+1} - x_n, \quad \operatorname{var}(y) = \frac{1}{K} \sum_{k=0}^{K-1} (y_k - \bar{y})^2 \text{ over the } K \text{ elements of } y \f]

Sources:
- Origin: Hjorth (1970). "EEG analysis based on time domain properties". Electroencephalography and Clinical Neurophysiology 29(3), table I and p. 308. <a href="https://doi.org/10.1016/0013-4694(70)90143-4">doi:10.1016/0013-4694(70)90143-4</a>

Validation level 0, not checked.

\section definition_hjorth_complexity Hjorth Complexity

xtract_hjorth_complexity()

\f[ C = \frac{M(\Delta x)}{M(x)}, \quad M(y) = \sqrt{\frac{\operatorname{var}(\Delta y)}{\operatorname{var}(y)}}, \quad \Delta y_n = y_{n+1} - y_n \f]

Sources:
- Origin: Hjorth (1970). "EEG analysis based on time domain properties". Electroencephalography and Clinical Neurophysiology 29(3), table I and p. 308. <a href="https://doi.org/10.1016/0013-4694(70)90143-4">doi:10.1016/0013-4694(70)90143-4</a>

Validation level 0, not checked.

\section definition_time_reversal_asymmetry Time Reversal Asymmetry

xtract_time_reversal_asymmetry()

\f[ T(k) = \frac{1}{N - k} \sum_{t=k}^{N-1} \left(x_t^2 x_{t-k} - x_t x_{t-k}^2\right), \quad 1 \le k \le N-1 \text{ the lag given in argv} \f]

Sources:
- Origin: Ramsey and Rothman (1996). "Time irreversibility and business cycle asymmetry". Journal of Money, Credit and Banking 28(1), equation 5, and equations 8 and 9 for the estimator. <a href="https://doi.org/10.2307/2077963">doi:10.2307/2077963</a>

Validation level 3, certified.

\section definition_spectral_entropy Spectral Entropy

xtract_spectral_entropy()

\f[ H = -\frac{1}{\ln N} \sum_{k : x_k > 0} p_k \ln p_k, \quad p_k = \frac{x_k}{\sum_{j : x_j > 0} x_j}, \text{ limited to } [0, 1]; \text{ no result when no } x_k > 0 \f]

Sources:
- Origin: Powell and Percival (1979). "A spectral entropy method for distinguishing regular and irregular motion of Hamiltonian systems". Journal of Physics A: Mathematical and General 12(11), equations 2.7 and 2.8. <a href="https://doi.org/10.1088/0305-4470/12/11/017">doi:10.1088/0305-4470/12/11/017</a>
- Formulation: Inouye, Shinosaki, Sakamoto, Toi, Ukai, Iyama, Katsuda and Hirano (1991). "Quantification of EEG irregularity by use of the entropy of the power spectrum". Electroencephalography and Clinical Neurophysiology 79(3), equations 1 and 2, and page 206 for the division by the largest entropy. <a href="https://doi.org/10.1016/0013-4694(91)90138-T">doi:10.1016/0013-4694(91)90138-T</a>

Validation level 0, not checked.

\section definition_petrosian_fractal_dimension Petrosian Fractal Dimension

xtract_petrosian_fractal_dimension()

\f[ D = \frac{\log N}{\log N + \log \frac{N}{N + 0.4 N_\delta}}, \quad N_\delta = \#\{1 \le n \le N-2 : b_n \ne b_{n-1}\}, \quad b_n = [x_{n+1} - x_n < 0] \f]

Sources:
- Origin: Petrosian (1995). "Kolmogorov complexity of finite sequences and recognition of different preictal EEG patterns". Proceedings of the Eighth IEEE Symposium on Computer-Based Medical Systems, p. 214, binary sequence (c). <a href="https://doi.org/10.1109/CBMS.1995.465426">doi:10.1109/CBMS.1995.465426</a>

Validation level 0, not checked.

\section definition_katz_fractal_dimension Katz Fractal Dimension

xtract_katz_fractal_dimension()

\f[ D = \frac{\log (N-1)}{\log (d / a)}, \quad L = \sum_{n=1}^{N-1} |x_n - x_{n-1}|, \quad a = \frac{L}{N-1}, \quad d = \max_{n} |x_n - x_0| \f]

Sources:
- Origin: Katz (1988). "Fractals and the analysis of waveforms". Computers in Biology and Medicine 18(3), equations 2 to 5. <a href="https://doi.org/10.1016/0010-4825(88)90041-8">doi:10.1016/0010-4825(88)90041-8</a>

Validation level 0, not checked.

\section definition_higuchi_fractal_dimension Higuchi Fractal Dimension

xtract_higuchi_fractal_dimension()

\f[ L_m(k) = \frac{N-1}{\lfloor (N-m)/k \rfloor k^2} \sum_{i=1}^{\lfloor (N-m)/k \rfloor} |x_{m+ik} - x_{m+(i-1)k}|, \quad \langle L(k) \rangle = \frac{1}{k} \sum_{m=1}^{k} L_m(k), \quad D = \text{the least-squares slope of } \ln \langle L(k) \rangle \text{ against } \ln \tfrac{1}{k}, \; k = 1, \dots, k_{\max} \f]

Sources:
- Origin: Higuchi (1988). "Approach to an irregular time series on the basis of the fractal theory". Physica D 31(2), section 2. <a href="https://doi.org/10.1016/0167-2789(88)90081-4">doi:10.1016/0167-2789(88)90081-4</a>

Validation level 0, not checked.

\section definition_permutation_entropy Permutation Entropy

xtract_permutation_entropy()

\f[ H = -\frac{1}{\ln m!} \sum_{\pi} p(\pi) \ln p(\pi), \quad p(\pi) = \frac{\#\{t : (x_t, x_{t+\tau}, \dots, x_{t+(m-1)\tau}) \text{ has ordinal pattern } \pi\}}{N - (m-1)\tau}, \text{ equal values ordered by position} \f]

Sources:
- Origin: Bandt and Pompe (2002). "Permutation entropy: a natural complexity measure for time series". Physical Review Letters 88(17), section II, and section III for the normalisation. <a href="https://doi.org/10.1103/PhysRevLett.88.174102">doi:10.1103/PhysRevLett.88.174102</a>
- Formulation: Cao, Tung, Gao, Protopopescu and Hively (2004). "Detecting dynamical changes in time series using the permutation entropy". Physical Review E 70(4), section II, the delay and the order of equal values. <a href="https://doi.org/10.1103/PhysRevE.70.046217">doi:10.1103/PhysRevE.70.046217</a>

Validation level 0, not checked.

\section definition_lempel_ziv_complexity Lempel-Ziv Complexity

xtract_lempel_ziv_complexity()

\f[ C = c(s) \frac{\log_2 N}{N}, \quad s_n = [x_n > \theta], \quad c(s) = \text{the number of components of the exhaustive history of } s_0 \cdots s_{N-1} \f]

Sources:
- Origin: Lempel and Ziv (1976). "On the complexity of finite sequences". IEEE Transactions on Information Theory 22(1), section III. <a href="https://doi.org/10.1109/TIT.1976.1055501">doi:10.1109/TIT.1976.1055501</a>
- Formulation: Kaspar and Schuster (1987). "Easily calculable measure for the complexity of spatiotemporal patterns". Physical Review A 36(2), figure 1 and equation 1. <a href="https://doi.org/10.1103/PhysRevA.36.842">doi:10.1103/PhysRevA.36.842</a>

Validation level 0, not checked.

\section definition_sample_entropy Sample Entropy

xtract_sample_entropy()

\f[ \mathrm{SampEn} = -\ln \frac{A}{B}, \quad B = \#\{i < j \le N-m : d_m(i,j) \le r\}, \quad A = \#\{i < j \le N-m : d_{m+1}(i,j) \le r\}, \quad d_L(i,j) = \max_{0 \le k < L} |x_{i+k} - x_{j+k}| \f]

Sources:
- Origin: Richman and Moorman (2000). "Physiological time-series analysis using approximate entropy and sample entropy". American Journal of Physiology - Heart and Circulatory Physiology 278(6), p. H2042. <a href="https://doi.org/10.1152/ajpheart.2000.278.6.H2039">doi:10.1152/ajpheart.2000.278.6.H2039</a>

Validation level 0, not checked.

\section definition_approximate_entropy Approximate Entropy

xtract_approximate_entropy()

\f[ \mathrm{ApEn} = \Phi^m - \Phi^{m+1}, \quad \Phi^L = \frac{1}{N-L+1} \sum_{i=1}^{N-L+1} \ln \frac{\#\{1 \le j \le N-L+1 : d_L(i,j) \le r\}}{N-L+1}, \quad d_L(i,j) = \max_{0 \le k < L} |x_{i+k} - x_{j+k}| \f]

Sources:
- Origin: Pincus (1991). "Approximate entropy as a measure of system complexity". Proceedings of the National Academy of Sciences of the USA 88(6), equations 1, 2, 6 and 10. <a href="https://doi.org/10.1073/pnas.88.6.2297">doi:10.1073/pnas.88.6.2297</a>
- Formulation: Richman and Moorman (2000). "Physiological time-series analysis using approximate entropy and sample entropy". American Journal of Physiology - Heart and Circulatory Physiology 278(6), p. H2040. <a href="https://doi.org/10.1152/ajpheart.2000.278.6.H2039">doi:10.1152/ajpheart.2000.278.6.H2039</a>

Validation level 0, not checked.

\section definition_periodicity Periodicity

xtract_periodicity()

\f[ P = \max_{\tau \text{ a key maximum}} h(\tau), \quad h(\tau) = \min\left(n_\tau - \frac{(n_{\tau-1} - n_{\tau+1})^2}{8 (n_{\tau-1} - 2 n_\tau + n_{\tau+1})}, 1\right), \quad n_\tau = \frac{2 \sum_{j=0}^{N-1-\tau} x_j x_{j+\tau}}{\sum_{j=0}^{N-1-\tau} (x_j^2 + x_{j+\tau}^2)}, \quad \text{key maxima taken over } 1 \le \tau \le \min(\lfloor N/2 \rfloor, N-2) \f]

Sources:
- Origin: McLeod and Wyvill (2005). "A smarter way to find pitch". Proceedings of the International Computer Music Conference, Barcelona, section 5

Validation level 0, not checked.

\section definition_signal_confidence Signal Confidence

xtract_signal_confidence()

\f[ c = h(\tau^*), \quad \tau^* \text{ the key maximum that the McLeod pitch method takes as the period}, \quad h(\tau) = \min\left(n_\tau - \frac{(n_{\tau-1} - n_{\tau+1})^2}{8 (n_{\tau-1} - 2 n_\tau + n_{\tau+1})}, 1\right), \quad \text{key maxima taken over } 1 \le \tau \le \min(\lfloor N/2 \rfloor, N-2) \f]

Sources:
- Origin: McLeod and Wyvill (2005). "A smarter way to find pitch". Proceedings of the International Computer Music Conference, Barcelona, section 7

Validation level 0, not checked.

\section definition_decay_rate Decay Rate

xtract_decay_rate()

\f[ D = \frac{\sum_{n \in S} (t_n - \bar t)(\ln x_n - \overline{\ln x})}{\sum_{n \in S} (t_n - \bar t)^2}, \quad t_n = \frac{n}{f_s}, \quad S = \{n \ge p : x_n > c\,x_{\max}\}, \quad p = \min\{n : x_n = x_{\max}\}, \quad \bar t, \overline{\ln x} \text{ the means over } S; \text{ no result when } x_{\max} \le 0 \text{ or } |S| < 2 \f]

Sources:
- Origin: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 3.1.3.1
- Formulation: Peeters, Giordano, Susini, Misdariis and McAdams (2011). "The Timbre Toolbox: extracting audio descriptors from musical signals". Journal of the Acoustical Society of America 130(5), equation 5. <a href="https://doi.org/10.1121/1.3642604">doi:10.1121/1.3642604</a>

Validation level 0, not checked.

\section definition_temporal_centroid Temporal Centroid

xtract_temporal_centroid()

\f[ TC = \frac{\sum_{n=0}^{N-1} n\,x_n}{(N-1)\sum_{n=0}^{N-1} x_n}; \text{ no result when } \sum_{n=0}^{N-1} x_n \le 0 \f]

Sources:
- Origin: Peeters, McAdams and Herrera (2000). "Instrument sound description in the context of MPEG-7". Proceedings of the International Computer Music Conference 2000, page 3, table. <a href="https://hal.science/hal-01161319">https://hal.science/hal-01161319</a>
- Formulation: Peeters (2004). "A large set of audio features for sound description (similarity and classification) in the CUIDADO project". Technical report, IRCAM, section 3.2.1

Validation level 3, certified.

\section definition_max_position Maximum Position

xtract_max_position()

\f[ P_{\max} = \frac{\min\{n : x_n = \max_{0 \le m < N} x_m\}}{N-1} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_min_position Minimum Position

xtract_min_position()

\f[ P_{\min} = \frac{\min\{n : x_n = \min_{0 \le m < N} x_m\}}{N-1} \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_peak_asymmetry Peak Asymmetry

xtract_peak_asymmetry()

\f[ A = \frac{\sum_{n=p}^{N-1} x_n^2}{\sum_{n=0}^{p} x_n^2}, \quad p = \min\{n : x_n = \max_{0 \le m < N} x_m\}; \text{ no result when } \sum_{n=0}^{p} x_n^2 = 0 \f]

Defined by the library: this definition is the reference.

Validation level 3, certified.

\section definition_cross_correlation Cross-correlation

xtract_cross_correlation()

\f[ r_k = \frac{1}{M} \sum_{n=\max(0,-k)}^{\min(M-1,\,M-1-k)} x_{n+k} \, y_n, \quad k = -(M-1), \dots, M-1, \quad M = N/2, \; x_n = d_n, \; y_n = d_{M+n} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_cross_correlation_lag Cross-correlation Lag

xtract_cross_correlation_lag()

\f[ \hat{k} = \arg\max_{k} \rho_k, \quad \rho_k \text{ the normalised cross-correlation}, \text{ the least } |k| \text{ on a tie and the negative of } \pm k; \text{ no result when } \rho \text{ has none} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_kullback_leibler_divergence Kullback-Leibler Divergence

xtract_kullback_leibler_divergence()

\f[ D = \sum_{k : p_k > 0} p_k \ln \frac{p_k}{q_k}, \quad p_k = \frac{X_n(k)}{\sum_j X_n(j)}, \quad q_k = \frac{X_{n-1}(k)}{\sum_j X_{n-1}(j)} \f]

Sources:
- Origin: Kullback and Leibler (1951). "On information and sufficiency". The Annals of Mathematical Statistics 22(1), equation 2.4. <a href="https://doi.org/10.1214/aoms/1177729694">doi:10.1214/aoms/1177729694</a>

Validation level 0, not checked.

\section definition_itakura_saito_divergence Itakura-Saito Divergence

xtract_itakura_saito_divergence()

\f[ D = \sum_k \left( \frac{P_n(k)}{P_{n-1}(k)} - \ln \frac{P_n(k)}{P_{n-1}(k)} - 1 \right) \f]

Sources:
- Origin: Itakura and Saito (1968). "Analysis synthesis telephony based on the maximum likelihood method". Proceedings of the 6th International Congress on Acoustics, Tokyo
- Formulation: Fevotte, Bertin and Durrieu (2009). "Nonnegative matrix factorization with the Itakura-Saito divergence: with application to music analysis". Neural Computation 21(3), equations 1.3 and 1.6, theorem 1. <a href="https://doi.org/10.1162/neco.2008.04-08-771">doi:10.1162/neco.2008.04-08-771</a>

Validation level 0, not checked.

\section definition_modified_kullback_leibler Modified Kullback-Leibler

xtract_modified_kullback_leibler()

\f[ D = \sum_{k : X_n(k) > 0} \ln \left( 1 + \frac{X_n(k)}{X_{n-1}(k) + \epsilon} \right) \f]

Sources:
- Origin: Hainsworth and Macleod (2003). "Onset detection in musical audio signals". Proceedings of the International Computer Music Conference, Singapore, equations 4 and 5
- Formulation: Brossier (2006). "Automatic annotation of musical audio for interactive applications". PhD thesis, Queen Mary, University of London, equation 2.9. <a href="https://aubio.org/phd/">https://aubio.org/phd/</a>

Validation level 0, not checked.

\section definition_spectral_contrast Spectral Contrast

xtract_spectral_contrast()

\f[ SC_j = \ln \frac{\frac{1}{a_j} \sum_{i=1}^{a_j} x_{j,(|B_j|-i+1)}}{\frac{1}{a_j} \sum_{i=1}^{a_j} x_{j,(i)}}, \quad a_j = \max(1, \lfloor \alpha |B_j| + \tfrac{1}{2} \rfloor), \quad B_0 = \{k : f_k < e\}, \; B_j = \{k : 2^{j-1} e \le f_k < 2^j e\}, \; B_K = \{k : f_k \ge 2^{K-1} e\}, \quad x_{j,(i)} \text{ the coefficients of } B_j \text{ in ascending order}, \; j = 0, \dots, K \f]

Sources:
- Origin: Jiang, Lu, Zhang, Tao and Cai (2002). "Music type classification by spectral contrast feature". Proceedings of the IEEE International Conference on Multimedia and Expo 2002, equations 1 to 3. <a href="https://doi.org/10.1109/ICME.2002.1035731">doi:10.1109/ICME.2002.1035731</a>

Validation level 0, not checked.

\section definition_chroma Chroma

xtract_chroma()

\f[ C_p = \frac{c_p}{\max_q c_q}, \quad c_p = \sum_{k : m_k = p} P_k, \quad m_k = \left(\left\lfloor 12 \log_2 \frac{f_k}{f_{A4}} + \tfrac{1}{2} \right\rfloor - 3\right) \bmod 12, \text{ over the bins with } f_k > 0 \text{ in the range given}, \; p = 0, \dots, 11 \f]

Sources:
- Origin: Fujishima (1999). "Realtime chord recognition of musical sound: a system using Common Lisp Music". Proceedings of the International Computer Music Conference 1999, section 2.2

Validation level 0, not checked.

\section definition_cqt Constant-Q Transform

xtract_cqt()

\f[ X_b = \left| \sum_{j=0}^{N/2-1} X_j \, \overline{K_{bj}} \right|, \quad K_{bj} = \frac{\sum_{n=0}^{L_b-1} w_b(n) \, e^{2 \pi i f_b n / f_s} e^{-2 \pi i j (n + s_b) / N}}{\sum_{n=0}^{L_b-1} w_b(n)}, \quad w_b(n) = \tfrac{1}{2} - \tfrac{1}{2} \cos \frac{2 \pi n}{L_b - 1}, \quad L_b = \mathrm{round}\left(\frac{Q f_s}{f_b}\right), \; s_b = \left\lfloor \frac{N - L_b}{2} \right\rfloor, \; Q = \frac{1}{2^{1/B} - 1}, \; f_b = f_{\min} 2^{b/B}, \; K_{bj} = 0 \text{ where } |K_{bj}| < \theta \max_j |K_{bj}| \f]

Sources:
- Origin: Brown (1991). "Calculation of a constant Q spectral transform". Journal of the Acoustical Society of America 89(1), section II, equations 1 to 3 and 5. <a href="https://doi.org/10.1121/1.400476">doi:10.1121/1.400476</a>
- Formulation: Brown and Puckette (1992). "An efficient algorithm for the calculation of a constant Q transform". Journal of the Acoustical Society of America 92(5), equations 1 to 7. <a href="https://doi.org/10.1121/1.404385">doi:10.1121/1.404385</a>

Validation level 0, not checked.

\section definition_pearson_correlation Pearson Correlation

xtract_pearson_correlation()

\f[ r = \frac{\sum_{n=0}^{M-1} (x_n - \bar{x})(y_n - \bar{y})}{\sqrt{\sum_{n=0}^{M-1} (x_n - \bar{x})^2} \sqrt{\sum_{n=0}^{M-1} (y_n - \bar{y})^2}} \text{ limited to } [-1, 1], \quad M = N/2, \; x_n = d_n, \; y_n = d_{M+n}; \text{ no result when either series is constant} \f]

Sources:
- Origin: Pearson (1896). "Mathematical contributions to the theory of evolution. III. Regression, heredity, and panmixia". Philosophical Transactions of the Royal Society of London, Series A 187, page 265. <a href="https://doi.org/10.1098/rsta.1896.0007">doi:10.1098/rsta.1896.0007</a>

Validation level 0, not checked.

\section definition_covariance_matrix Covariance Matrix

xtract_covariance_matrix()

\f[ S_{ij} = \frac{1}{M-1} \sum_{n=0}^{M-1} (x^{(i)}_n - \bar{x}^{(i)})(x^{(j)}_n - \bar{x}^{(j)}), \quad i, j = 0, \dots, C-1, \quad M = N/C, \quad x^{(i)}_n = d_{iM+n}, \quad C \text{ the number of series given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_correlation_matrix Correlation Matrix

xtract_correlation_matrix()

\f[ R_{ij} = \frac{S_{ij}}{\sqrt{S_{ii}} \sqrt{S_{jj}}} \text{ limited to } [-1, 1] \text{ for } i \ne j, \; R_{ii} = 1, \quad S_{ij} = S_{ji} = d_{iC+j} \text{ for } i \le j \text{ (the upper triangle)}, \quad C = \sqrt{N}; \text{ no result when some } S_{ii} \le 0 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_average_correlation Average Correlation

xtract_average_correlation()

\f[ \bar{r} = \frac{1}{C(C-1)} \sum_{i=0}^{C-1} \sum_{j \ne i} R_{ij}, \quad C = \sqrt{N} \ge 2 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_principal_variances Principal Variances

xtract_principal_variances()

\f[ \lambda_0 \ge \lambda_1 \ge \dots \ge \lambda_{C-1}, \quad \det(S - \lambda I) = 0, \quad S_{ij} = S_{ji} = d_{iC+j} \text{ for } i \le j, \quad C = \sqrt{N} \f]

Sources:
- Origin: Pearson (1901). "On lines and planes of closest fit to systems of points in space". The London, Edinburgh, and Dublin Philosophical Magazine and Journal of Science 2(11), equation x, page 562. <a href="https://doi.org/10.1080/14786440109462720">doi:10.1080/14786440109462720</a>

Validation level 0, not checked.

\section definition_coherence Coherence

xtract_coherence()

\f[ \gamma^2_k = \min\left(1, \frac{|\sum_s X_s(k) Y_s(k)^*|^2}{\sum_s |X_s(k)|^2 \sum_s |Y_s(k)|^2}\right), \text{ or } 0 \text{ when either sum of squares is } 0, \quad X_s(k) = \sum_{n=0}^{L-1} w_n (x_{sL/2+n} - \bar{x}_s) e^{-2\pi i k n/L}, \quad w_n = \tfrac{1}{2} - \tfrac{1}{2}\cos\tfrac{2\pi n}{L}, \quad s = 0, \dots, \lfloor 2(M-L)/L \rfloor, \quad k = 0, \dots, L/2-1, \quad M = N/2, \; x_n = d_n, \; y_n = d_{M+n}, \quad Y_s \text{ the same of } y, \quad L \text{ the segment length given in argv}; \text{ no result when every } \gamma^2_k \text{ is 0 for that reason} \f]

Sources:
- Origin: Welch (1967). "The use of fast Fourier transform for the estimation of power spectra: a method based on time averaging over short, modified periodograms". IEEE Transactions on Audio and Electroacoustics 15(2), page 70, and page 73 for cross spectra. <a href="https://doi.org/10.1109/TAU.1967.1161901">doi:10.1109/TAU.1967.1161901</a>
- Formulation: Carter, Knapp and Nuttall (1973). "Estimation of the magnitude-squared coherence function via overlapped fast Fourier transform processing". IEEE Transactions on Audio and Electroacoustics 21(4), equations 11 and 12. <a href="https://doi.org/10.1109/TAU.1973.1162496">doi:10.1109/TAU.1973.1162496</a>

Validation level 0, not checked.

\section definition_grid_moments Grid Moments

xtract_grid_moments()

\f[ m_{pq} = \sum_{y=0}^{H-1} \sum_{x=0}^{W-1} x^p y^q \, g_{yW+x}, \quad (p, q) \in \{(0,0), (1,0), (0,1), (2,0), (1,1), (0,2), (3,0), (2,1), (1,2), (0,3)\}, \quad W \text{ the width given in argv}, \; H = N/W \f]

Sources:
- Origin: Hu (1962). "Visual pattern recognition by moment invariants". IRE Transactions on Information Theory 8(2), equation 1. <a href="https://doi.org/10.1109/TIT.1962.1057692">doi:10.1109/TIT.1962.1057692</a>

Validation level 0, not checked.

\section definition_grid_central_moments Grid Central Moments

xtract_grid_central_moments()

\f[ \mu_{pq} = \sum_{y=0}^{H-1} \sum_{x=0}^{W-1} (x - \bar{x})^p (y - \bar{y})^q \, g_{yW+x}, \quad \bar{x} = m_{10}/m_{00}, \; \bar{y} = m_{01}/m_{00}, \quad (p, q) \in \{(0,0), (2,0), (1,1), (0,2), (3,0), (2,1), (1,2), (0,3)\}; \text{ no result when } m_{00} = 0 \f]

Sources:
- Origin: Hu (1962). "Visual pattern recognition by moment invariants". IRE Transactions on Information Theory 8(2), equations 8 and 9. <a href="https://doi.org/10.1109/TIT.1962.1057692">doi:10.1109/TIT.1962.1057692</a>

Validation level 0, not checked.

\section definition_normalised_moments Normalised Moments

xtract_normalised_moments()

\f[ \nu_{pq} = \frac{\mu_{pq}}{\mu_{00}^{1 + (p+q)/2}}, \quad (p, q) \in \{(2,0), (1,1), (0,2), (3,0), (2,1), (1,2), (0,3)\} \f]

Sources:
- Origin: Hu (1962). "Visual pattern recognition by moment invariants". IRE Transactions on Information Theory 8(2), equation 31. <a href="https://doi.org/10.1109/TIT.1962.1057692">doi:10.1109/TIT.1962.1057692</a>

Validation level 0, not checked.

\section definition_hu_moments Hu Moments

xtract_hu_moments()

\f[ \phi_1 = \nu_{20} + \nu_{02}, \; \phi_2 = (\nu_{20} - \nu_{02})^2 + 4 \nu_{11}^2, \; \phi_3 = (\nu_{30} - 3\nu_{12})^2 + (3\nu_{21} - \nu_{03})^2, \; \phi_4 = (\nu_{30} + \nu_{12})^2 + (\nu_{21} + \nu_{03})^2, \; \phi_5 = (\nu_{30} - 3\nu_{12})(\nu_{30} + \nu_{12})[(\nu_{30} + \nu_{12})^2 - 3(\nu_{21} + \nu_{03})^2] + (3\nu_{21} - \nu_{03})(\nu_{21} + \nu_{03})[3(\nu_{30} + \nu_{12})^2 - (\nu_{21} + \nu_{03})^2], \; \phi_6 = (\nu_{20} - \nu_{02})[(\nu_{30} + \nu_{12})^2 - (\nu_{21} + \nu_{03})^2] + 4\nu_{11}(\nu_{30} + \nu_{12})(\nu_{21} + \nu_{03}), \; \phi_7 = (3\nu_{21} - \nu_{03})(\nu_{30} + \nu_{12})[(\nu_{30} + \nu_{12})^2 - 3(\nu_{21} + \nu_{03})^2] - (\nu_{30} - 3\nu_{12})(\nu_{21} + \nu_{03})[3(\nu_{30} + \nu_{12})^2 - (\nu_{21} + \nu_{03})^2] \f]

Sources:
- Origin: Hu (1962). "Visual pattern recognition by moment invariants". IRE Transactions on Information Theory 8(2), equations 61 and 62. <a href="https://doi.org/10.1109/TIT.1962.1057692">doi:10.1109/TIT.1962.1057692</a>

Validation level 0, not checked.

\section definition_quantise Quantise

xtract_quantise()

\f[ q_n = 0 \text{ if } x_n \le a, \quad \text{otherwise } L-1 \text{ if } x_n \ge b, \quad \text{otherwise } \min\left(\left\lfloor L \frac{x_n - a}{b - a} \right\rfloor, L-1\right), \quad \text{NaN for a NaN } x_n, \quad a, b, L \text{ the bounds and the number of levels given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_histogram Histogram

xtract_histogram()

\f[ h_k = \frac{1}{N} \left|\{n : x_n = k\}\right|, \quad k = 0, \dots, L-1, \quad L \text{ the number of levels given in argv}; \text{ an argument error when some } x_n \text{ is not a whole number in } [0, L) \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_cooccurrence_matrix Co-occurrence Matrix

xtract_cooccurrence_matrix()

\f[ P_{ij} = \frac{\#\{(y,x) : g_{y,x} = i, \, g_{y+\Delta r, x+\Delta c} = j\} + s \, \#\{(y,x) : g_{y,x} = j, \, g_{y+\Delta r, x+\Delta c} = i\}}{(1 + s)(W - |\Delta c|)(H - |\Delta r|)}, \quad s \in \{0, 1\}, \; i, j = 0, \dots, L-1 \f]

Sources:
- Origin: Haralick, Shanmugam and Dinstein (1973). "Textural features for image classification". IEEE Transactions on Systems, Man, and Cybernetics SMC-3(6), equation 1 and figure 3. <a href="https://doi.org/10.1109/TSMC.1973.4309314">doi:10.1109/TSMC.1973.4309314</a>

Validation level 0, not checked.

\section definition_cooccurrence_contrast Co-occurrence Contrast

xtract_cooccurrence_contrast()

\f[ \sum_{i,j} (i - j)^2 p_{ij}, \quad p_{ij} = \frac{P_{ij}}{\sum_{k,l} P_{kl}} \f]

Sources:
- Origin: Haralick, Shanmugam and Dinstein (1973). "Textural features for image classification". IEEE Transactions on Systems, Man, and Cybernetics SMC-3(6), appendix I, feature 2. <a href="https://doi.org/10.1109/TSMC.1973.4309314">doi:10.1109/TSMC.1973.4309314</a>

Validation level 3, certified.

\section definition_cooccurrence_correlation Co-occurrence Correlation

xtract_cooccurrence_correlation()

\f[ \frac{\sum_{i,j} (i - \mu_i)(j - \mu_j) p_{ij}}{\sigma_i \sigma_j}, \quad \mu_i = \sum_{i,j} i \, p_{ij}, \; \sigma_i^2 = \sum_{i,j} (i - \mu_i)^2 p_{ij}, \text{ and likewise for } j, \quad p_{ij} = \frac{P_{ij}}{\sum_{k,l} P_{kl}} \f]

Sources:
- Origin: Haralick, Shanmugam and Dinstein (1973). "Textural features for image classification". IEEE Transactions on Systems, Man, and Cybernetics SMC-3(6), appendix I, feature 3. <a href="https://doi.org/10.1109/TSMC.1973.4309314">doi:10.1109/TSMC.1973.4309314</a>

Validation level 0, not checked.

\section definition_angular_second_moment Angular Second Moment

xtract_angular_second_moment()

\f[ \sum_{i,j} p_{ij}^2, \quad p_{ij} = \frac{P_{ij}}{\sum_{k,l} P_{kl}} \f]

Sources:
- Origin: Haralick, Shanmugam and Dinstein (1973). "Textural features for image classification". IEEE Transactions on Systems, Man, and Cybernetics SMC-3(6), appendix I, feature 1. <a href="https://doi.org/10.1109/TSMC.1973.4309314">doi:10.1109/TSMC.1973.4309314</a>

Validation level 3, certified.

\section definition_inverse_difference_moment Inverse Difference Moment

xtract_inverse_difference_moment()

\f[ \sum_{i,j} \frac{p_{ij}}{1 + (i - j)^2}, \quad p_{ij} = \frac{P_{ij}}{\sum_{k,l} P_{kl}} \f]

Sources:
- Origin: Haralick, Shanmugam and Dinstein (1973). "Textural features for image classification". IEEE Transactions on Systems, Man, and Cybernetics SMC-3(6), appendix I, feature 5. <a href="https://doi.org/10.1109/TSMC.1973.4309314">doi:10.1109/TSMC.1973.4309314</a>

Validation level 0, not checked.

\section definition_local_binary_patterns Local Binary Patterns

xtract_local_binary_patterns()

\f[ h_c = \frac{\#\{(y, x) : 1 \le y \le H-2, \, 1 \le x \le W-2, \, \mathrm{LBP}(y, x) = c\}}{(W-2)(H-2)}, \quad \mathrm{LBP} = \begin{cases} \sum_{p=0}^{7} s(g_p - g_c) & U \le 2 \\ 9 & \text{otherwise} \end{cases}, \quad U = \sum_{p=0}^{7} |s(g_p - g_c) - s(g_{(p+1) \bmod 8} - g_c)|, \quad s(t) = [t \ge 0], \quad g_p \text{ at } (-\sin\tfrac{\pi p}{4}, \cos\tfrac{\pi p}{4}) \text{ bilinearly interpolated} \f]

Sources:
- Origin: Ojala, Pietikainen and Maenpaa (2002). "Multiresolution gray-scale and rotation invariant texture classification with local binary patterns". IEEE Transactions on Pattern Analysis and Machine Intelligence 24(7), equations 6, 9 and 10, P = 8, R = 1. <a href="https://doi.org/10.1109/TPAMI.2002.1017623">doi:10.1109/TPAMI.2002.1017623</a>

Validation level 0, not checked.

\section definition_last_n Last N Values

xtract_last_n()

\f[ y_k = v_{t-N+1+k}, \quad k = 0, \ldots, N-1, \quad v_t \text{ the value given at call } t \text{ (from 0)}, \quad v_j = 0 \text{ for } j < 0 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_packed Packed Spectrum

xtract_packed()

\f[ r_k = a_{n_k}, \; r_{M+k} = f_{n_k} \text{ for the } K \text{ indices } n_0 < \ldots < n_{K-1} \text{ with } a_n \ne 0; \; r_k = r_{M+k} = 0 \text{ for } k \ge K, \quad a_n = x_n, \; f_n = x_{M+n}, \; M = N/2 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_magnitude_spectrum Magnitude Spectrum

xtract_magnitude_spectrum()

\f[ r_m = \sqrt{a_m^2 + b_m^2}, \quad r_{M+m} = m \Delta f, \quad a_m = x_m, \; b_m = x_{M+m}, \quad m = 0, \ldots, M-1, \quad M = N/2, \quad \Delta f \text{ the bin spacing given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_power_spectrum Power Spectrum

xtract_power_spectrum()

\f[ r_m = a_m^2 + b_m^2, \quad r_{M+m} = m \Delta f, \quad a_m = x_m, \; b_m = x_{M+m}, \quad m = 0, \ldots, M-1, \quad M = N/2, \quad \Delta f \text{ the bin spacing given in argv} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_log_spectrum Log Spectrum

xtract_log_spectrum()

\f[ r_m = 1 + \frac{\ln P_m}{-\ln \epsilon^2} \text{ if } P_m > \epsilon^2, \text{ else } 0, \quad P_m = a_m^2 + b_m^2, \quad r_{M+m} = m \Delta f, \quad a_m = x_m, \; b_m = x_{M+m}, \quad M = N/2, \quad \epsilon = 2^{-52} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_phase_spectrum Phase Spectrum

xtract_phase_spectrum()

\f[ r_m = \operatorname{atan2}(b_m, a_m) \in [-\pi, \pi], \; \operatorname{atan2}(0, 0) = 0, \quad r_{M+m} = m \Delta f, \quad a_m = x_m, \; b_m = x_{M+m}, \quad M = N/2 \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

\section definition_log Logarithm

xtract_log()

\f[ y_k = \ln(1 + \lambda x_k) \f]

Sources:
- Origin: Boeck, Krebs and Schedl (2012). "Evaluating the online capabilities of onset detection methods". Proceedings of the 13th International Society for Music Information Retrieval Conference, equation 1. <a href="https://doi.org/10.5281/zenodo.1416036">doi:10.5281/zenodo.1416036</a>

Validation level 0, not checked.

\section definition_normalised_cross_correlation Normalised Cross-Correlation

xtract_normalised_cross_correlation()

\f[ \rho_k = \frac{\sum_{n=\max(0,-k)}^{\min(M-1,\,M-1-k)} (x_{n+k} - \bar{x})(y_n - \bar{y})}{\sqrt{\sum_{n=0}^{M-1} (x_n - \bar{x})^2} \sqrt{\sum_{n=0}^{M-1} (y_n - \bar{y})^2}} \text{ limited to } [-1, 1], \quad k = -(M-1), \dots, M-1, \quad M = N/2, \; x_n = d_n, \; y_n = d_{M+n}; \text{ no result when either series is constant} \f]

Defined by the library: this definition is the reference.

Validation level 0, not checked.

*/
