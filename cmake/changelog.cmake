# Checks CHANGELOG.md against the rules in the Changelog section of
# CONTRIBUTING.md that a script can test, and reports every line that breaks
# one. CHANGELOG is the file to check, CHANGELOG.md at the repository root by
# default.

cmake_minimum_required(VERSION 3.21)

set(max_words 20)
set(sections Added Changed Deprecated Removed Fixed Security)

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT CHANGELOG)
    set(CHANGELOG "${root}/CHANGELOG.md")
endif()
file(READ "${CHANGELOG}" text)
file(STRINGS "${root}/VERSION" version LIMIT_COUNT 1)

# A CMake list splits on a semicolon and joins across an unbalanced square
# bracket, and a backslash escapes the separator after it, so each of the
# four is replaced by a control character before the text is split into
# lines. A carriage return is dropped so that a checkout with CRLF line
# endings gives the same lines.
string(ASCII 1 semicolon)
string(ASCII 2 open)
string(ASCII 3 close)
string(ASCII 4 backslash)
string(REPLACE ";" "${semicolon}" text "${text}")
string(REPLACE "[" "${open}" text "${text}")
string(REPLACE "]" "${close}" text "${text}")
string(REPLACE "\\" "${backslash}" text "${text}")
string(REPLACE "\r" "" text "${text}")
string(REGEX REPLACE "\n$" "" text "${text}")
string(REPLACE "\n" ";" lines "${text}")

set(number "[0-9]+\\.[0-9]+\\.[0-9]+")
set(date "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]")

set(errors "")
set(releases "")
set(links "")
set(release "")
set(release_line 0)
set(link_line 0)
set(links_closed 0)
set(section -1)
set(section_line 0)
set(section_count 0)
set(entry_count 0)
set(n 0)

macro(fail_at number message)
    string(APPEND errors "\n  line ${number}: ${message}")
endmacro()

macro(fail message)
    fail_at(${n} "${message}")
endmacro()

macro(close_section)
    if(section_line AND entry_count EQUAL 0)
        fail_at(${section_line} "the section has no entry")
    endif()
    set(section_line 0)
endmacro()

macro(close_release)
    close_section()
    if(release_line AND section_count EQUAL 0)
        fail_at(${release_line} "the release has no section")
    endif()
endmacro()

foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    if(link_line AND NOT links_closed AND NOT line STREQUAL "" AND NOT line MATCHES "^${open}")
        fail_at(${link_line} "the links come after the last release and line ${n} is not a link")
        set(links_closed 1)
    endif()
    if(n EQUAL 1)
        if(NOT line STREQUAL "# Changelog")
            fail("the file must open with '# Changelog'")
        endif()
    elseif(line MATCHES "^## ")
        close_release()
        if(line MATCHES "^## ${open}(${number})${close} - ${date}$")
            if(release_line EQUAL 0)
                if(NOT CMAKE_MATCH_1 STREQUAL version)
                    fail("the newest release must be ${version}, the version in VERSION")
                endif()
            elseif(release AND NOT CMAKE_MATCH_1 VERSION_LESS release)
                fail("releases must run from newest to oldest")
            endif()
            set(release "${CMAKE_MATCH_1}")
            list(APPEND releases "${release}")
        else()
            fail("a release heading has the form '## [X.Y.Z] - YYYY-MM-DD'")
            set(release "")
        endif()
        set(release_line ${n})
        set(section -1)
        set(section_count 0)
    elseif(line MATCHES "^### (.*)$")
        close_section()
        list(FIND sections "${CMAKE_MATCH_1}" index)
        if(release_line EQUAL 0)
            fail("a section heading must come under a release heading")
        elseif(index EQUAL -1)
            list(JOIN sections ", " names)
            fail("a section heading must be one of ${names}")
        elseif(NOT index GREATER section)
            list(JOIN sections ", " names)
            fail("sections appear once each, in the order ${names}")
        else()
            set(section ${index})
        endif()
        set(section_line ${n})
        set(entry_count 0)
        math(EXPR section_count "${section_count} + 1")
    elseif(line MATCHES "^${open}")
        if(line MATCHES "^${open}(${number})${close}: https://[^ ]+/compare/v(${number})\\.\\.\\.v(${number})$"
                AND CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_1)
            list(APPEND links "${CMAKE_MATCH_1}")
            set(from_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        else()
            fail("a link has the form '[X.Y.Z]: https://.../compare/vA.B.C...vX.Y.Z'")
        endif()
        if(NOT link_line)
            set(link_line ${n})
        endif()
    elseif(line STREQUAL "" OR release_line EQUAL 0)
    elseif(line MATCHES "^- (.+)$")
        set(entry "${CMAKE_MATCH_1}")
        if(section EQUAL -1)
            fail("an entry must come under a section heading")
        endif()
        string(REGEX MATCHALL "[^ ]+" words "${entry}")
        list(LENGTH words count)
        if(count GREATER max_words)
            fail("the entry has ${count} words and the limit is ${max_words}")
        endif()
        if(entry MATCHES "\\.$")
            fail("an entry does not end with a full stop")
        endif()
        if(entry MATCHES "\\. ")
            fail("an entry is one phrase and this one has a second sentence")
        endif()
        math(EXPR entry_count "${entry_count} + 1")
    else()
        fail("a release holds section headings and one-line entries starting '- ' and nothing else")
    endif()
endforeach()
close_release()

if(n EQUAL 0)
    fail_at(1 "the file must open with '# Changelog'")
elseif(releases STREQUAL "")
    fail("the file has no release heading")
endif()
set(newer "")
foreach(release IN LISTS releases)
    if(NOT release IN_LIST links)
        fail("release ${release} has no '[${release}]: https://...' link at the foot of the file")
    endif()
    if(newer AND newer IN_LIST links AND NOT from_${newer} STREQUAL release)
        fail("the link for ${newer} must compare from v${release}, the release before it")
    endif()
    set(newer "${release}")
endforeach()
if(newer AND newer IN_LIST links AND NOT from_${newer} VERSION_LESS newer)
    fail("the link for ${newer} must compare from an earlier version")
endif()
foreach(link IN LISTS links)
    if(NOT link IN_LIST releases)
        fail("the link for ${link} matches no release heading")
    endif()
endforeach()

if(errors)
    message(FATAL_ERROR "${CHANGELOG} breaks the changelog rules in CONTRIBUTING.md:${errors}")
endif()
