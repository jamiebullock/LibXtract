# Writes the feature enumeration (include/xtract/xtract_features.h) and the
# dispatch and descriptor tables (src/features.c) from src/features.json,
# after checking every record. The written files are committed. With CHECK
# set they are written under WORK instead and compared with the committed
# ones, and a difference is an error.

cmake_minimum_required(VERSION 3.21)

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(data_file "${root}/src/features.json")
set(header include/xtract/xtract_features.h)
set(source src/features.c)

set(UNITS unknown none any any_squared any_cubed hertz hertz_squared per_hertz any_amplitude_hertz
          seconds per_second decibels percent bins midi_cent sone acum)
set(RELATIVE_UNITS unknown none any any_squared any_cubed)
set(FORMATS spectral spectral_magnitudes spectral_peaks spectral_peaks_magnitudes spectral_peaks_frequencies
            spectral_harmonics spectral_harmonics_magnitudes spectral_harmonics_frequencies autocorrelation_coeffs
            arbitrary_series audio_samples mel_coeffs lpc_coeffs lpcc_coeffs bark_coeffs subframes no_data
            spectral_magnitude_phase chroma_coeffs channels square_matrix grid central_moment_coeffs
            normalised_moment_coeffs)
set(VALUE_TYPES float int)
set(OBJECT_TYPES floatarray intarray filterbank cqt_kernel last_n_state wavelet_f0_state)
set(PROPERTIES length sample_rate transform_size bin_spacing width series levels)
set(SUBJECTS input source)
set(PARTS whole first_half from_one_before_the_second_half)
set(TAGS sound)
set(MAXARGS 5)
foreach(list VALUE_TYPES OBJECT_TYPES PROPERTIES SUBJECTS PARTS TAGS)
    list(JOIN ${list} ", " ${list}_TEXT)
endforeach()

function(fail where message)
    message(FATAL_ERROR "${data_file}: ${where}: ${message}")
endfunction()

# Fails when the object has a member that is not one of the keys in ARGN
function(only_keys where json)
    string(JSON count LENGTH "${json}")
    if(count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${json}" ${i})
        if(NOT key IN_LIST ARGN)
            fail("${where}" "the unknown key '${key}'")
        endif()
    endforeach()
endfunction()

# Sets ${out} to the member at the key, which must have the JSON type
function(required out where json type key)
    string(JSON actual ERROR_VARIABLE error TYPE "${json}" "${key}")
    if(error)
        fail("${where}" "'${key}' is missing")
    endif()
    if(NOT actual STREQUAL type)
        fail("${where}" "'${key}' is ${actual}, expected ${type}")
    endif()
    string(JSON value GET "${json}" "${key}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the member at the key, which must have the JSON type, or to
# the default when the member is absent
function(optional out where json type key default)
    string(JSON actual ERROR_VARIABLE error TYPE "${json}" "${key}")
    if(error)
        set(${out} "${default}" PARENT_SCOPE)
        return()
    endif()
    if(NOT actual STREQUAL type)
        fail("${where}" "'${key}' is ${actual}, expected ${type}")
    endif()
    string(JSON value GET "${json}" "${key}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the number at the key, which must be a whole number from 0
# to the largest int, or to the default when the member is absent
function(optional_count out where json key default)
    optional(value "${where}" "${json}" NUMBER "${key}" "${default}")
    if(NOT value MATCHES "^[0-9]+$" OR value GREATER 2147483647)
        fail("${where}" "'${key}' is ${value}, expected a whole number from 0 to 2147483647")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Sets ${out} to ON or OFF, the flag at the key, or OFF when it is absent
function(optional_flag out where json key)
    optional(value "${where}" "${json}" BOOLEAN "${key}" OFF)
    if(value)
        set(${out} ON PARENT_SCOPE)
    else()
        set(${out} OFF PARENT_SCOPE)
    endif()
endfunction()

# Fails when the text is not a name: lower case letters, digits and
# underscores, the first a letter
function(check_name where key text)
    if(NOT text MATCHES "^[a-z][a-z0-9_]*$")
        fail("${where}" "'${key}' is '${text}', which is not lower case letters, digits and underscores")
    endif()
endfunction()

# Sets ${out} to a C string literal of the text
function(c_string out where key text)
    if(text STREQUAL "")
        fail("${where}" "'${key}' is empty")
    endif()
    if(NOT text MATCHES "^[ -~]*$")
        fail("${where}" "'${key}' has a character that is not printable ASCII")
    endif()
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    # Two question marks and a third character can form a trigraph, which a
    # C99 compiler replaces inside a string literal
    string(REPLACE "?" "\\?" text "${text}")
    set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

# Fails when both ends of a range are given and the least is above the
# greatest
function(check_range where minimum maximum)
    if(NOT minimum STREQUAL "XTRACT_UNBOUNDED_MIN" AND NOT maximum STREQUAL "XTRACT_UNBOUNDED_MAX"
       AND minimum GREATER maximum)
        fail("${where}" "the minimum ${minimum} is above the maximum ${maximum}")
    endif()
endfunction()

function(unit_enumerator out where key name)
    if(NOT name IN_LIST UNITS)
        fail("${where}" "'${key}' is '${name}', which is not a unit")
    endif()
    string(TOUPPER "${name}" upper)
    if(name IN_LIST RELATIVE_UNITS)
        set(${out} "XTRACT_UNIT_${upper}" PARENT_SCOPE)
    else()
        set(${out} "XTRACT_${upper}" PARENT_SCOPE)
    endif()
endfunction()

function(format_enumerator out where key name)
    if(NOT name IN_LIST FORMATS)
        fail("${where}" "'${key}' is '${name}', which is not a format")
    endif()
    string(TOUPPER "XTRACT_${name}" upper)
    set(${out} "${upper}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the name of the array of C strings that has the names in
# the JSON array, writing the array to value_arrays the first time the
# names are met
function(value_names out count_out where names)
    string(JSON count LENGTH "${names}")
    if(count LESS 2)
        fail("${where}" "'values' names fewer than two values")
    endif()
    set(strings "")
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON type TYPE "${names}" ${i})
        if(NOT type STREQUAL "STRING")
            fail("${where}" "'values' has a member that is ${type}, expected STRING")
        endif()
        string(JSON value GET "${names}" ${i})
        check_name("${where}" values "${value}")
        list(APPEND strings "\"${value}\"")
    endforeach()
    list(JOIN strings ", " strings)
    list(FIND value_lists "${strings}" index)
    if(index EQUAL -1)
        list(LENGTH value_lists index)
        list(APPEND value_lists "${strings}")
        string(APPEND value_arrays "static const char *const values_${index}[] = {${strings}};\n")
        set(value_lists "${value_lists}" PARENT_SCOPE)
        set(value_arrays "${value_arrays}" PARENT_SCOPE)
    endif()
    set(${out} "values_${index}" PARENT_SCOPE)
    set(${count_out} "${count}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the C initialiser of one argument of a feature or one
# parameter of a builder. ${shared_type} is the type every value among a
# feature's arguments has, or empty for a parameter, which names its own.
# ARGN is the kinds the argument may be
function(argument_initialiser out where argument shared_type)
    required(name "${where}" "${argument}" STRING name)
    check_name("${where}" name "${name}")
    set(where "${where}, argument '${name}'")
    required(kind "${where}" "${argument}" STRING kind)
    if(NOT kind IN_LIST ARGN)
        list(JOIN ARGN ", " kinds)
        fail("${where}" "'kind' is '${kind}', which is not one of ${kinds}")
    endif()

    set(fields "")
    if(kind STREQUAL "object")
        only_keys("${where}" "${argument}" name kind built_by optional)
        required(builder "${where}" "${argument}" STRING built_by)
        if(NOT builder IN_LIST builder_names)
            fail("${where}" "'built_by' is '${builder}', which is not a builder")
        endif()
        set(type "${builder_type_${builder}}")
        optional_flag(is_optional "${where}" "${argument}" optional)
        string(APPEND fields ", .builder = &builder_${builder}")
        if(is_optional)
            string(APPEND fields ", .is_optional = XTRACT_TRUE")
        endif()
        set(unit XTRACT_UNIT_NONE)
        set(minimum XTRACT_UNBOUNDED_MIN)
        set(maximum XTRACT_UNBOUNDED_MAX)
    else()
        if(shared_type STREQUAL "")
            required(type "${where}" "${argument}" STRING type)
            if(NOT type IN_LIST VALUE_TYPES)
                fail("${where}" "'type' is '${type}', which is not one of ${VALUE_TYPES_TEXT}")
            endif()
            set(type_key type)
        else()
            set(type "${shared_type}")
            set(type_key "")
        endif()
        optional(unit "${where}" "${argument}" STRING unit none)
        unit_enumerator(unit "${where}" unit "${unit}")
        optional(minimum "${where}" "${argument}" NUMBER min XTRACT_UNBOUNDED_MIN)
        optional(maximum "${where}" "${argument}" NUMBER max XTRACT_UNBOUNDED_MAX)
        check_range("${where}" "${minimum}" "${maximum}")
        if(type STREQUAL "int")
            foreach(key min max default)
                string(JSON number ERROR_VARIABLE error GET "${argument}" ${key})
                if(NOT error AND (number LESS -2147483648 OR number GREATER 2147483647))
                    fail("${where}" "'${key}' is ${number}, which an int cannot be")
                endif()
            endforeach()
        endif()
    endif()

    if(kind STREQUAL "result")
        only_keys("${where}" "${argument}" name kind ${type_key} accepts of unit min max)
        required(quantity "${where}" "${argument}" STRING accepts)
        if(NOT quantity IN_LIST names AND NOT quantity IN_LIST quantity_names)
            fail("${where}" "'accepts' is '${quantity}', which is not a feature or a quantity")
        endif()
        foreach(provider ${quantity} ${providers_${quantity}})
            if(provider IN_LIST names)
                if(NOT is_scalar_${provider})
                    fail("${where}" "it accepts '${quantity}', and the result of '${provider}' is a vector")
                endif()
                if(NOT unit STREQUAL result_unit_${provider})
                    fail("${where}" "it accepts '${quantity}' in ${unit}, and '${provider}' gives ${result_unit_${provider}}")
                endif()
            endif()
        endforeach()
        if(NOT quantity IN_LIST used_quantities)
            list(APPEND used_quantities "${quantity}")
            set(used_quantities "${used_quantities}" PARENT_SCOPE)
        endif()
        string(APPEND fields ", .accepts = &quantity_${quantity}")
        optional(subject "${where}" "${argument}" STRING of "")
        if(NOT subject STREQUAL "")
            if(NOT subject IN_LIST SUBJECTS)
                fail("${where}" "'of' is '${subject}', which is not one of ${SUBJECTS_TEXT}")
            endif()
            string(TOUPPER "XTRACT_SUBJECT_${subject}" subject)
            string(APPEND fields ", .subject = ${subject}")
        endif()
    elseif(kind STREQUAL "property")
        only_keys("${where}" "${argument}" name kind ${type_key} property unit min max)
        required(property "${where}" "${argument}" STRING property)
        if(NOT property IN_LIST PROPERTIES)
            fail("${where}" "'property' is '${property}', which is not one of ${PROPERTIES_TEXT}")
        endif()
        string(TOUPPER "XTRACT_PROPERTY_${property}" property)
        string(APPEND fields ", .data_property = ${property}")
    elseif(kind STREQUAL "setting")
        only_keys("${where}" "${argument}" name kind ${type_key} unit min max default whole values sets)
        optional(result_property "${where}" "${argument}" STRING sets "")
        if(NOT result_property STREQUAL "")
            if(NOT result_property IN_LIST PROPERTIES)
                fail("${where}" "'sets' is '${result_property}', which is not one of ${PROPERTIES_TEXT}")
            endif()
            string(TOUPPER "XTRACT_PROPERTY_${result_property}" result_property)
            string(APPEND fields ", .result_property = ${result_property}")
        endif()
        required(default "${where}" "${argument}" NUMBER default)
        optional_flag(is_whole "${where}" "${argument}" whole)
        if(type STREQUAL "int")
            set(is_whole ON)
        endif()
        string(JSON values_type ERROR_VARIABLE error TYPE "${argument}" values)
        if(NOT error)
            if(NOT minimum STREQUAL "XTRACT_UNBOUNDED_MIN" OR NOT maximum STREQUAL "XTRACT_UNBOUNDED_MAX")
                fail("${where}" "it has both 'values' and a range")
            endif()
            string(JSON values GET "${argument}" values)
            set(is_whole ON)
            set(minimum 0)
            if(values_type STREQUAL "OBJECT")
                # The values are features: each feature the setting takes
                # has its name at its own number, and no other number has one
                only_keys("${where}, 'values'" "${values}" features)
                required(taken "${where}, 'values'" "${values}" ARRAY features)
                string(JSON taken_count LENGTH "${taken}")
                if(taken_count EQUAL 0)
                    fail("${where}" "'values' names no feature")
                endif()
                set(taken_names "")
                set(rows "")
                math(EXPR last_taken "${taken_count} - 1")
                foreach(t RANGE ${last_taken})
                    string(JSON taken_name GET "${taken}" ${t})
                    if(NOT taken_name IN_LIST names)
                        fail("${where}" "'values' names '${taken_name}', which is not a feature")
                    endif()
                    if(taken_name IN_LIST taken_names)
                        fail("${where}" "'values' names '${taken_name}' twice")
                    endif()
                    list(APPEND taken_names "${taken_name}")
                    string(TOUPPER "XTRACT_${taken_name}" taken_c)
                    string(APPEND rows "    [${taken_c}] = \"${taken_name}\",\n")
                endforeach()
                list(LENGTH value_lists index)
                list(JOIN taken_names " " taken_text)
                list(APPEND value_lists "features ${taken_text}")
                string(APPEND value_arrays "static const char *const values_${index}[XTRACT_FEATURES] = {\n${rows}};\n")
                set(value_lists "${value_lists}" PARENT_SCOPE)
                set(value_arrays "${value_arrays}" PARENT_SCOPE)
                set(maximum "XTRACT_FEATURES - 1")
                string(APPEND fields ", .value_count = XTRACT_FEATURES, .values = values_${index}")
                set(last_value ${last})
                if(default MATCHES "^[0-9]+$" AND NOT default GREATER last)
                    list(GET names ${default} default_name)
                    if(NOT default_name IN_LIST taken_names)
                        fail("${where}" "the default is '${default_name}', which is not one of its values")
                    endif()
                endif()
            elseif(values_type STREQUAL "ARRAY")
                value_names(array value_count "${where}" "${values}")
                set(value_lists "${value_lists}" PARENT_SCOPE)
                set(value_arrays "${value_arrays}" PARENT_SCOPE)
                math(EXPR last_value "${value_count} - 1")
                set(maximum ${last_value})
                string(APPEND fields ", .value_count = ${value_count}, .values = ${array}")
            else()
                fail("${where}" "'values' is not an array of names or an object that lists features")
            endif()
            if(default LESS 0 OR default GREATER last_value)
                fail("${where}" "the default ${default} is not one of its values")
            endif()
        else()
            if(NOT minimum STREQUAL "XTRACT_UNBOUNDED_MIN" AND default LESS minimum)
                fail("${where}" "the default ${default} is below the minimum ${minimum}")
            endif()
            if(NOT maximum STREQUAL "XTRACT_UNBOUNDED_MAX" AND default GREATER maximum)
                fail("${where}" "the default ${default} is above the maximum ${maximum}")
            endif()
        endif()
        if(is_whole AND NOT default MATCHES "^-?[0-9]+$")
            fail("${where}" "the default ${default} is not a whole number")
        endif()
        string(APPEND fields ", .default_value = ${default}")
        if(is_whole)
            string(APPEND fields ", .is_whole = XTRACT_TRUE")
        endif()
    endif()

    string(TOUPPER "XTRACT_ARGUMENT_${kind}" kind)
    string(TOUPPER "XTRACT_${type}" type)
    set(${out}
        "    {.name = \"${name}\", .kind = ${kind}, .type = ${type}, .unit = ${unit}, .min = ${minimum}, .max = ${maximum}${fields}},\n"
        PARENT_SCOPE)
endfunction()

file(READ "${data_file}" doc)
only_keys("the file" "${doc}" quantities builders features)
string(JSON count LENGTH "${doc}" features)
if(count EQUAL 0)
    fail("the file" "no features")
endif()
math(EXPR last "${count} - 1")

# What a later record may refer to: the name of every feature, whether its
# result is a scalar, the unit of that result and the quantities it provides
set(names "")
set(quantity_names "")
set(used_quantities "")
foreach(i RANGE ${last})
    string(JSON feature GET "${doc}" features ${i})
    required(name "feature ${i}" "${feature}" STRING name)
    check_name("feature ${i}" name "${name}")
    if(name IN_LIST names)
        fail("feature '${name}'" "the name is used twice")
    endif()
    list(APPEND names "${name}")
    set(where "feature '${name}'")
    required(result "${where}" "${feature}" OBJECT result)
    required(kind "${where}" "${result}" STRING kind)
    required(result_unit "${where}" "${result}" STRING unit)
    unit_enumerator(result_unit_${name} "${where}" result.unit "${result_unit}")
    if(kind STREQUAL "scalar")
        set(is_scalar_${name} ON)
    elseif(kind STREQUAL "vector")
        set(is_scalar_${name} OFF)
    else()
        fail("${where}" "'result.kind' is '${kind}', which is not scalar or vector")
    endif()
    set(argument_names_${name} "")
    string(JSON argument_count ERROR_VARIABLE error LENGTH "${feature}" arguments)
    if(NOT error AND argument_count GREATER 0)
        math(EXPR last_argument "${argument_count} - 1")
        foreach(a RANGE ${last_argument})
            string(JSON argument_name ERROR_VARIABLE error GET "${feature}" arguments ${a} name)
            list(APPEND argument_names_${name} "${argument_name}")
            set(value_names_${name}_${argument_name} "")
            string(JSON values_type ERROR_VARIABLE error TYPE "${feature}" arguments ${a} values)
            if(values_type STREQUAL "ARRAY")
                string(JSON value_count LENGTH "${feature}" arguments ${a} values)
                math(EXPR last_value "${value_count} - 1")
                foreach(v RANGE ${last_value})
                    string(JSON value ERROR_VARIABLE error GET "${feature}" arguments ${a} values ${v})
                    list(APPEND value_names_${name}_${argument_name} "${value}")
                endforeach()
            endif()
        endforeach()
    endif()
endforeach()

optional(quantities "the file" "${doc}" ARRAY quantities "[]")
string(JSON quantity_count LENGTH "${quantities}")
if(quantity_count GREATER 0)
    math(EXPR last_quantity "${quantity_count} - 1")
    foreach(i RANGE ${last_quantity})
        string(JSON quantity GET "${quantities}" ${i})
        required(name "quantity ${i}" "${quantity}" STRING name)
        check_name("quantity ${i}" name "${name}")
        set(where "quantity '${name}'")
        only_keys("${where}" "${quantity}" name default)
        if(name IN_LIST names OR name IN_LIST quantity_names)
            fail("${where}" "the name is that of a feature or of another quantity")
        endif()
        list(APPEND quantity_names "${name}")
        required(quantity_default_${name} "${where}" "${quantity}" STRING default)
    endforeach()
endif()

foreach(i RANGE ${last})
    string(JSON feature GET "${doc}" features ${i})
    string(JSON name GET "${feature}" name)
    set(where "feature '${name}'")
    optional(provides "${where}" "${feature}" ARRAY provides "[]")
    string(JSON provided_count LENGTH "${provides}")
    if(provided_count GREATER 0)
        math(EXPR last_provided "${provided_count} - 1")
        foreach(p RANGE ${last_provided})
            string(JSON entry_type TYPE "${provides}" ${p})
            string(JSON entry GET "${provides}" ${p})
            set(part whole)
            set(setting -1)
            set(value 0)
            set(given "")
            if(entry_type STREQUAL "STRING")
                set(quantity "${entry}")
            elseif(entry_type STREQUAL "OBJECT")
                only_keys("${where}, 'provides'" "${entry}" quantity part when given)
                required(quantity "${where}, 'provides'" "${entry}" STRING quantity)
                optional(part "${where}, it provides '${quantity}'" "${entry}" STRING part whole)
                if(NOT part IN_LIST PARTS)
                    fail("${where}, it provides '${quantity}'" "'part' is '${part}', which is not one of ${PARTS_TEXT}")
                endif()
                optional(when "${where}, it provides '${quantity}'" "${entry}" OBJECT when "")
                if(NOT when STREQUAL "")
                    only_keys("${where}, it provides '${quantity}', 'when'" "${when}" argument value)
                    required(argument "${where}, it provides '${quantity}', 'when'" "${when}" STRING argument)
                    list(FIND argument_names_${name} "${argument}" setting)
                    if(setting EQUAL -1)
                        fail("${where}, it provides '${quantity}'" "'when' names '${argument}', which is not one of its arguments")
                    endif()
                    string(JSON value_type ERROR_VARIABLE error TYPE "${when}" value)
                    string(JSON value ERROR_VARIABLE error GET "${when}" value)
                    if(value_type STREQUAL "STRING")
                        list(FIND value_names_${name}_${argument} "${value}" index)
                        if(index EQUAL -1)
                            fail("${where}, it provides '${quantity}'" "'when' gives '${argument}' the value '${value}', which is not one of its values")
                        endif()
                        set(value ${index})
                    elseif(NOT value_type STREQUAL "NUMBER")
                        fail("${where}, it provides '${quantity}'" "'when' has no value that is a number or the name of one")
                    endif()
                endif()
                optional(given "${where}, it provides '${quantity}'" "${entry}" STRING given "")
                if(NOT given STREQUAL "")
                    if(NOT given IN_LIST names AND NOT given IN_LIST quantity_names)
                        fail("${where}, it provides '${quantity}'" "'given' is '${given}', which is not a feature or a quantity")
                    endif()
                    if(NOT given IN_LIST used_quantities)
                        list(APPEND used_quantities "${given}")
                    endif()
                endif()
            else()
                fail("${where}" "'provides' has a member that is ${entry_type}, expected a name or an object")
            endif()
            if(quantity STREQUAL name)
                fail("${where}" "'provides' names the feature itself, which every feature provides")
            endif()
            if(NOT quantity IN_LIST names AND NOT quantity IN_LIST quantity_names)
                fail("${where}" "it provides '${quantity}', which is not a feature or a quantity")
            endif()
            if(name IN_LIST providers_${quantity})
                fail("${where}" "it provides '${quantity}' twice")
            endif()
            set(provider_part_${quantity}_${name} "${part}")
            set(provider_setting_${quantity}_${name} "${setting}")
            set(provider_value_${quantity}_${name} "${value}")
            set(provider_given_${quantity}_${name} "${given}")
            list(APPEND providers_${quantity} "${name}")
        endforeach()
    endif()
endforeach()
foreach(quantity ${quantity_names})
    if(NOT quantity_default_${quantity} IN_LIST providers_${quantity})
        fail("quantity '${quantity}'" "the default '${quantity_default_${quantity}}' does not provide it")
    endif()
    list(REMOVE_ITEM providers_${quantity} "${quantity_default_${quantity}}")
    list(PREPEND providers_${quantity} "${quantity_default_${quantity}}")
endforeach()

set(value_lists "")
set(value_arrays "")

set(builder_names "")
set(builder_text "")
optional(builders "the file" "${doc}" ARRAY builders "[]")
string(JSON builder_count LENGTH "${builders}")
if(builder_count GREATER 0)
    math(EXPR last_builder "${builder_count} - 1")
    foreach(i RANGE ${last_builder})
        string(JSON builder GET "${builders}" ${i})
        required(name "builder ${i}" "${builder}" STRING name)
        check_name("builder ${i}" name "${name}")
        set(where "builder '${name}'")
        only_keys("${where}" "${builder}" name type per_stream parameters)
        if(name IN_LIST builder_names)
            fail("${where}" "the name is used twice")
        endif()
        required(type "${where}" "${builder}" STRING type)
        if(NOT type IN_LIST OBJECT_TYPES)
            fail("${where}" "'type' is '${type}', which is not one of ${OBJECT_TYPES_TEXT}")
        endif()
        optional_flag(per_stream "${where}" "${builder}" per_stream)
        required(parameters "${where}" "${builder}" ARRAY parameters)
        string(JSON parameter_count LENGTH "${parameters}")
        if(parameter_count EQUAL 0)
            fail("${where}" "no parameters")
        endif()
        set(rows "")
        math(EXPR last_parameter "${parameter_count} - 1")
        foreach(p RANGE ${last_parameter})
            string(JSON parameter GET "${parameters}" ${p})
            argument_initialiser(row "${where}" "${parameter}" "" property setting)
            string(APPEND rows "${row}")
        endforeach()
        if(per_stream)
            set(per_stream XTRACT_TRUE)
        else()
            set(per_stream XTRACT_FALSE)
        endif()
        string(TOUPPER "XTRACT_${type}" type_c)
        string(APPEND builder_text
            "static const xtract_argument_descriptor_t parameters_${name}[] = {\n${rows}};\n"
            "static const xtract_builder_descriptor_t builder_${name} = {\"${name}\", ${type_c}, ${per_stream}, ${parameter_count}, parameters_${name}, xtract_build_${name}, xtract_release_${name}};\n\n")
        list(APPEND builder_names "${name}")
        set(builder_type_${name} "${type}")
    endforeach()
endif()

set(enumeration "")
set(dispatch "")
set(argument_text "")
set(accepted_text "")
set(table "")
foreach(i RANGE ${last})
    string(JSON feature GET "${doc}" features ${i})
    string(JSON name GET "${feature}" name)
    set(where "feature '${name}'")
    only_keys("${where}" "${feature}"
        name title description reference tags provides input argument_type arguments delta result)
    string(TOUPPER "XTRACT_${name}" id)
    string(APPEND enumeration "        ${id},\n")
    string(APPEND dispatch "        xtract_${name},\n")

    required(title "${where}" "${feature}" STRING title)
    required(description "${where}" "${feature}" STRING description)
    c_string(title_c "${where}" title "${title}")
    c_string(description_c "${where}" description "${description}")

    optional(reference "${where}" "${feature}" OBJECT reference "{}")
    only_keys("${where}" "${reference}" author year)
    optional(author "${where}" "${reference}" STRING author "")
    optional_count(year "${where}" "${reference}" year 0)
    if(author STREQUAL "")
        if(NOT reference STREQUAL "{}")
            fail("${where}" "'reference' has no author")
        endif()
        set(author_c NULL)
    else()
        c_string(author_c "${where}" reference.author "${author}")
    endif()

    optional(tags "${where}" "${feature}" ARRAY tags "[]")
    string(JSON tag_count LENGTH "${tags}")
    set(tag_flags "")
    if(tag_count GREATER 0)
        math(EXPR last_tag "${tag_count} - 1")
        foreach(t RANGE ${last_tag})
            string(JSON tag GET "${tags}" ${t})
            if(NOT tag IN_LIST TAGS)
                fail("${where}" "the tag '${tag}' is not one of ${TAGS_TEXT}")
            endif()
            string(TOUPPER "XTRACT_TAG_${tag}" flag)
            if(flag IN_LIST tag_flags)
                fail("${where}" "the tag '${tag}' is given twice")
            endif()
            list(APPEND tag_flags "${flag}")
        endforeach()
        list(JOIN tag_flags " | " tag_flags)
    else()
        set(tag_flags 0)
    endif()

    required(input "${where}" "${feature}" OBJECT input)
    only_keys("${where}" "${input}" format unit accepts frames)
    required(input_format "${where}" "${input}" STRING format)
    required(input_unit "${where}" "${input}" STRING unit)
    format_enumerator(input_format "${where}" input.format "${input_format}")
    unit_enumerator(input_unit "${where}" input.unit "${input_unit}")
    optional_count(frames "${where}" "${input}" frames 1)
    if(NOT frames EQUAL 1 AND NOT frames EQUAL 2)
        fail("${where}" "'input.frames' is ${frames}, expected 1 or 2")
    endif()
    optional(accepts "${where}" "${input}" ARRAY accepts "[]")
    string(JSON accepted_count LENGTH "${accepts}")
    set(accepted NULL)
    if(accepted_count GREATER 0)
        set(accepted_quantities "")
        math(EXPR last_accepted "${accepted_count} - 1")
        foreach(q RANGE ${last_accepted})
            string(JSON quantity GET "${accepts}" ${q})
            if(NOT quantity IN_LIST names AND NOT quantity IN_LIST quantity_names)
                fail("${where}" "its input accepts '${quantity}', which is not a feature or a quantity")
            endif()
            if("&quantity_${quantity}" IN_LIST accepted_quantities)
                fail("${where}" "its input accepts '${quantity}' twice")
            endif()
            foreach(provider ${quantity} ${providers_${quantity}})
                if(provider IN_LIST names AND is_scalar_${provider})
                    fail("${where}" "its input accepts '${quantity}', and the result of '${provider}' is a scalar")
                endif()
            endforeach()
            if(NOT quantity IN_LIST used_quantities)
                list(APPEND used_quantities "${quantity}")
            endif()
            list(APPEND accepted_quantities "&quantity_${quantity}")
        endforeach()
        list(JOIN accepted_quantities ", " accepted_quantities)
        string(APPEND accepted_text "static const xtract_quantity_t *const accepted_${name}[] = {${accepted_quantities}};\n")
        set(accepted "accepted_${name}")
    endif()

    required(arguments "${where}" "${feature}" ARRAY arguments)
    string(JSON argc LENGTH "${arguments}")
    if(argc GREATER MAXARGS)
        fail("${where}" "${argc} arguments, and the most is ${MAXARGS}")
    endif()
    optional(argument_type "${where}" "${feature}" STRING argument_type "")
    if(NOT argument_type STREQUAL "" AND NOT argument_type IN_LIST VALUE_TYPES)
        fail("${where}" "'argument_type' is '${argument_type}', which is not one of ${VALUE_TYPES_TEXT}")
    endif()
    set(argv NULL)
    if(argc GREATER 0)
        set(rows "")
        set(objects 0)
        set(argument_names "")
        math(EXPR last_argument "${argc} - 1")
        foreach(a RANGE ${last_argument})
            string(JSON argument GET "${arguments}" ${a})
            string(JSON argument_kind ERROR_VARIABLE error GET "${argument}" kind)
            string(JSON argument_name ERROR_VARIABLE error GET "${argument}" name)
            if(argument_name IN_LIST argument_names)
                fail("${where}" "two arguments are named '${argument_name}'")
            endif()
            list(APPEND argument_names "${argument_name}")
            if(argument_kind STREQUAL "object")
                math(EXPR objects "${objects} + 1")
            elseif(argument_type STREQUAL "")
                fail("${where}" "it takes values and has no 'argument_type'")
            endif()
            argument_initialiser(row "${where}" "${argument}" "${argument_type}" result property object setting)
            string(APPEND rows "${row}")
        endforeach()
        # argv points to an array of values of one type or to one object
        if(objects GREATER 0 AND (argc GREATER 1 OR NOT argument_type STREQUAL ""))
            fail("${where}" "an object is its only argument, and it has others or an 'argument_type'")
        endif()
        string(APPEND argument_text "static const xtract_argument_descriptor_t arguments_${name}[] = {\n${rows}};\n\n")
        set(argv "arguments_${name}")
    elseif(NOT argument_type STREQUAL "")
        fail("${where}" "it has an 'argument_type' and no arguments")
    endif()

    optional_flag(delta "${where}" "${feature}" delta)
    if(delta)
        set(is_delta XTRACT_TRUE)
    else()
        set(is_delta XTRACT_FALSE)
    endif()

    string(JSON result GET "${feature}" result)
    if(is_scalar_${name})
        only_keys("${where}" "${result}" kind unit min max)
        optional(result_minimum "${where}" "${result}" NUMBER min XTRACT_UNBOUNDED_MIN)
        optional(result_maximum "${where}" "${result}" NUMBER max XTRACT_UNBOUNDED_MAX)
        check_range("${where}, 'result'" "${result_minimum}" "${result_maximum}")
        set(is_scalar XTRACT_TRUE)
        set(result_c ".scalar = {${result_minimum}, ${result_maximum}, ${result_unit_${name}}}")
    else()
        only_keys("${where}" "${result}" kind unit format)
        required(result_format "${where}" "${result}" STRING format)
        format_enumerator(result_format "${where}" result.format "${result_format}")
        set(is_scalar XTRACT_FALSE)
        set(result_c ".vector = {${result_format}, ${result_unit_${name}}}")
    endif()

    string(APPEND table
        "    [${id}] = {\n"
        "        .id = ${id},\n"
        "        .name = \"${name}\",\n"
        "        .title = ${title_c},\n"
        "        .description = ${description_c},\n"
        "        .author = ${author_c},\n"
        "        .year = ${year},\n"
        "        .tags = ${tag_flags},\n"
        "        .data = {${input_format}, ${input_unit}, ${accepted_count}, ${accepted}, ${frames}},\n"
        "        .argc = ${argc},\n"
        "        .argv = ${argv},\n"
        "        .is_scalar = ${is_scalar},\n"
        "        .is_delta = ${is_delta},\n"
        "        .result = {${result_c}},\n"
        "    },\n")
endforeach()

# A quantity named after a feature has that feature first among its
# providers; one with a record has its default first
# A quantity that a provider must be given is written before the quantity
# that provider gives, so that every reference is to something already
# defined
set(quantity_text "")
set(written_quantities "")
set(waiting_quantities ${used_quantities})
while(waiting_quantities)
    set(still_waiting "")
    foreach(quantity ${waiting_quantities})
        if(quantity IN_LIST names)
            set(providers ${quantity} ${providers_${quantity}})
        else()
            set(providers ${providers_${quantity}})
        endif()
        list(LENGTH providers provider_count)
        set(rows "")
        set(ready ON)
        foreach(provider ${providers})
            string(TOUPPER "XTRACT_${provider}" feature_c)
            if(provider STREQUAL quantity)
                string(APPEND rows "    {${feature_c}, XTRACT_PART_WHOLE, -1, 0, NULL},\n")
            else()
                string(TOUPPER "XTRACT_PART_${provider_part_${quantity}_${provider}}" part_c)
                set(given "${provider_given_${quantity}_${provider}}")
                if(given STREQUAL "")
                    set(given_c NULL)
                else()
                    set(given_c "&quantity_${given}")
                    if(NOT given IN_LIST written_quantities)
                        set(ready OFF)
                    endif()
                endif()
                string(APPEND rows
                    "    {${feature_c}, ${part_c}, ${provider_setting_${quantity}_${provider}}, ${provider_value_${quantity}_${provider}}, ${given_c}},\n")
            endif()
        endforeach()
        if(ready)
            list(APPEND written_quantities "${quantity}")
            string(APPEND quantity_text
                "static const xtract_provider_t providers_${quantity}[] = {\n${rows}};\n"
                "static const xtract_quantity_t quantity_${quantity} = {\"${quantity}\", ${provider_count}, providers_${quantity}};\n\n")
        else()
            list(APPEND still_waiting "${quantity}")
        endif()
    endforeach()
    if(still_waiting STREQUAL waiting_quantities)
        fail("the quantities '${still_waiting}'" "each must be given another of them")
    endif()
    set(waiting_quantities ${still_waiting})
endwhile()
foreach(quantity ${quantity_names})
    if(NOT quantity IN_LIST used_quantities)
        fail("quantity '${quantity}'" "no argument and no input accepts it")
    endif()
endforeach()

if(NOT value_arrays STREQUAL "")
    string(APPEND value_arrays "\n")
endif()

set(licence "/* Part of LibXtract\n *\n * SPDX-FileCopyrightText: 2026 Jamie Bullock\n * SPDX-License-Identifier: Zlib\n */\n")
set(notice "written from src/features.json by the build target \"features\"")

string(CONCAT header_text
    "${licence}\n"
    "/** \\file xtract_features.h: the enumeration of the features, ${notice} */\n\n"
    "#ifndef XTRACT_FEATURES_H\n#define XTRACT_FEATURES_H\n\n"
    "#ifdef __cplusplus\nextern \"C\"\n{\n#endif\n\n"
    "    /** \\brief Enumeration of features, elements are used as indices to an array of pointers to feature extraction functions */\n"
    "    enum xtract_features_\n    {\n"
    "${enumeration}"
    "        XTRACT_FEATURE_COUNT\n    };\n\n"
    "#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
string(CONCAT source_text
    "${licence}\n"
    "/* The dispatch table and the descriptor table, ${notice} */\n\n"
    "#include <stddef.h>\n\n"
    "#include \"xtract/libxtract.h\"\n\n"
    "#include \"xtract_descriptors_private.h\"\n\n"
    "int (*xtract[])(xtract_context *, const double *, const int, const void *, double *) =\n    {\n"
    "${dispatch}"
    "};\n\n"
    "${value_arrays}"
    "${builder_text}"
    "${quantity_text}"
    "${accepted_text}\n"
    "${argument_text}"
    "const xtract_function_descriptor_t xtract_descriptor_table[XTRACT_FEATURES] = {\n"
    "${table}"
    "};\n")

if(CHECK)
    if(NOT WORK)
        message(FATAL_ERROR "CHECK needs WORK, a directory to write to")
    endif()
    set(destination "${WORK}")
else()
    set(destination "${root}")
endif()
file(WRITE "${destination}/${header}" "${header_text}")
file(WRITE "${destination}/${source}" "${source_text}")

if(CHECK)
    foreach(file ${header} ${source})
        execute_process(
            COMMAND ${CMAKE_COMMAND} -E compare_files --ignore-eol "${root}/${file}" "${WORK}/${file}"
            RESULT_VARIABLE result
            OUTPUT_QUIET ERROR_QUIET)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${file} is not what src/features.json gives: build the target \"features\" and commit the result")
        endif()
    endforeach()
endif()
